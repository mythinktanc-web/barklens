{
  "name": "barklens-marketing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "server": "node server/index.mjs",
    "test:waitlist": "node --test server/*.test.mjs",
    "legal:build": "node scripts/build-approved-legal.mjs",
    "build": "astro build",
    "audit:build": "node scripts/audit-build.mjs",
    "test:launch": "npm run check && npm run test:waitlist && npm run build && npm run audit:build",
    "preview:bundle": "node scripts/prepare-preview.mjs",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "^4.13.0",
    "typescript": "6.0.3"
  }
}
