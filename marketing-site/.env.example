# Vercel production enables indexing automatically. Set this to false only
# when building a production release outside Vercel.
PUBLIC_SITE_NOINDEX=true
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_WAITLIST_API_URL=/api/waitlist

WAITLIST_PUBLIC_ORIGIN=https://barklens.com
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=barklens.com
MAILGUN_LIST_ADDRESS=waitlist@barklens.com
