---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { site } from '@config/site';
import '@styles/global.css';

interface Props {
  title: string;
  socialTitle?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  compactFooter?: boolean;
  hideFooterOnMobile?: boolean;
  showAiDisclosure?: boolean;
}

const productionIndexingEnabled =
  import.meta.env.PUBLIC_SITE_NOINDEX === 'false' ||
  process.env.VERCEL_ENV === 'production';
const {
  title,
  socialTitle = title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  noindex = !productionIndexingEnabled,
  image = '/images/desktop-hero.webp',
  type = 'website',
  structuredData,
  compactFooter = false,
  hideFooterOnMobile = false,
  showAiDisclosure = false
} = Astro.props;
const canonical = new URL(canonicalPath, site.canonicalOrigin);
const socialImage = new URL(image, site.canonicalOrigin);
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true';
const analyticsId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const analyticsConfigured = analyticsEnabled && Boolean(analyticsId);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.canonicalOrigin,
  email: site.contactEmail,
  logo: new URL('/favicon-192.png', site.canonicalOrigin).href,
  sameAs: site.socialProfiles
};
const schemas = structuredData
  ? [organizationSchema, ...(Array.isArray(structuredData) ? structuredData : [structuredData])]
  : [organizationSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png?v=2" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0f1f1a" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="BarkLens" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer compact={compactFooter} hideOnMobile={hideFooterOnMobile} showAiDisclosure={showAiDisclosure} />
    {analyticsConfigured && (
      <div class="cookie-banner" data-cookie-banner role="region" aria-label="Cookie choices" hidden>
        <p>
          BarkLens uses optional Google Analytics cookies to understand how visitors use this site.
          They load only if you accept. <a href="/privacy/">Privacy Policy</a>
        </p>
        <div class="cookie-banner__actions">
          <button type="button" data-cookie-choice="declined">Decline</button>
          <button type="button" data-cookie-choice="accepted">Accept</button>
        </div>
      </div>
      <script is:inline define:vars={{ analyticsId }}>
        (() => {
          const name = 'barklens_cookie_choice';
          const banner = document.querySelector('[data-cookie-banner]');
          const settings = document.querySelector('[data-cookie-settings]');
          const read = () => document.cookie.split('; ').find((item) => item.startsWith(`${name}=`))?.split('=')[1] || '';
          const save = (value) => {
            const secure = location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = `${name}=${value}; Max-Age=15552000; Path=/; SameSite=Lax${secure}`;
          };
          const clearAnalyticsCookies = () => {
            document.cookie.split('; ').map((item) => item.split('=')[0]).filter((key) => key === '_ga' || key.startsWith('_ga_')).forEach((key) => {
              document.cookie = `${key}=; Max-Age=0; Path=/`;
              document.cookie = `${key}=; Max-Age=0; Path=/; Domain=.${location.hostname.replace(/^www\./, '')}`;
            });
          };
          let loaded = false;
          const loadAnalytics = () => {
            window[`ga-disable-${analyticsId}`] = false;
            if (loaded) return;
            loaded = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', analyticsId, { anonymize_ip: true });
            const script = document.createElement('script');
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(analyticsId)}`;
            document.head.append(script);
          };
          const apply = (choice) => {
            if (choice === 'accepted') loadAnalytics();
            if (choice === 'declined') {
              window[`ga-disable-${analyticsId}`] = true;
              clearAnalyticsCookies();
            }
          };
          if (settings) {
            settings.hidden = false;
            settings.addEventListener('click', () => { banner.hidden = false; banner.querySelector('button')?.focus(); });
          }
          banner.querySelectorAll('[data-cookie-choice]').forEach((button) => button.addEventListener('click', () => {
            const choice = button.dataset.cookieChoice;
            save(choice);
            apply(choice);
            banner.hidden = true;
          }));
          const stored = read();
          if (stored) apply(stored);
          else if (navigator.globalPrivacyControl === true) apply('declined');
          else banner.hidden = false;
        })();
      </script>
    )}
  </body>
</html>

<style>
  .cookie-banner {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    left: var(--space-5);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    max-width: 52rem;
    margin-inline: auto;
    padding: var(--space-5) var(--space-6);
    border: 1px solid rgb(220 230 226 / 22%);
    border-radius: var(--radius-lg);
    color: #dce6e2;
    background: var(--color-forest-950);
    box-shadow: 0 1.25rem 3rem rgb(0 0 0 / 28%);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner a {
    color: var(--color-mint-400);
    text-decoration: underline;
    text-underline-offset: .15em;
  }

  .cookie-banner__actions {
    display: flex;
    flex: 0 0 auto;
    gap: var(--space-3);
  }

  .cookie-banner__actions button {
    min-width: 6.5rem;
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: 1px solid rgb(220 230 226 / 45%);
    border-radius: var(--radius-pill);
    color: #fff;
    background: transparent;
    font-weight: 700;
  }

  @media (max-width: 47.99rem) {
    .cookie-banner {
      right: var(--space-3);
      bottom: var(--space-3);
      left: var(--space-3);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding: var(--space-5);
    }

    .cookie-banner__actions button {
      flex: 1;
    }
  }
</style>
