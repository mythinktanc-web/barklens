---
import Wordmark from './Wordmark.astro';
import { routes, site } from '@config/site';

interface Props {
  compact?: boolean;
  hideOnMobile?: boolean;
}

const { compact = false, hideOnMobile = false } = Astro.props;
---

<footer class:list={['site-footer', { 'site-footer--compact': compact, 'site-footer--mobile-hidden': hideOnMobile }]}>
  <div class="site-footer__grid container">
    <div class="site-footer__brand">
      <Wordmark inverse />
      {compact && (
        <p class="site-footer__statement">
          The internet knows dogs. <em>BarkLens knows yours.</em>
        </p>
      )}
      <p>
        <span class="site-footer__boundary">BarkLens doesn’t diagnose. Your vet does.</span><br />
        <a href={routes.terms}>Not veterinary advice — see Terms.</a>
      </p>
    </div>

    <nav aria-label="Product">
      <p>Product</p>
      <a href={routes.howItWorks}>How it works</a>
      <a href="/#why-barklens">Why BarkLens</a>
      <a href={routes.plans}>Plans</a>
    </nav>

    <nav aria-label="Company">
      <p>Company</p>
      <a href={routes.charlieStory}>Our Story</a>
      <a href={routes.blog}>Blog</a>
      <a href={`mailto:${site.contactEmail}`}>Contact</a>
    </nav>

    <nav aria-label="Legal">
      <p>Legal</p>
      <a href={routes.privacy}>Privacy</a>
      <a href={routes.terms}>Terms</a>
      <a href={routes.records}>Your records</a>
    </nav>

    <nav class="site-footer__social" aria-label="Social media">
      <p>Follow</p>
      <a href="https://www.instagram.com/gobarklens/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.tiktok.com/@barklens" target="_blank" rel="noopener">TikTok</a>
      <a href="https://www.pinterest.com/gobarklens/" target="_blank" rel="noopener">Pinterest</a>
      <a href="https://www.facebook.com/profile.php?id=61586751886579" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.youtube.com/@gobarklens" target="_blank" rel="noopener">YouTube</a>
    </nav>
  </div>
  <div class="site-footer__bottom container">
    <span>© 2026 {site.legalName}</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-16) 0 var(--space-8);
    background: var(--color-forest-950);
    color: #dce6e2;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, minmax(7rem, 1fr));
    gap: var(--space-12);
  }

  .site-footer__brand p {
    margin-top: var(--space-5);
    color: #a9bdb6;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .site-footer__brand p a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: .2rem;
  }

  .site-footer__boundary {
    white-space: nowrap;
  }

  .site-footer nav {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .site-footer nav p {
    margin-bottom: var(--space-2);
    color: var(--color-mint-500);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .site-footer nav a:hover {
    color: var(--color-mint-400);
  }

  .site-footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(220 230 226 / 18%);
    color: #a9bdb6;
    font-size: var(--text-xs);
  }

  .site-footer--compact {
    padding: 2.5rem 0 2.25rem;
    background: #0f2a2e;
  }

  .site-footer--compact .site-footer__grid {
    display: block;
    width: min(calc(100% - 2 * var(--space-10)), 68.75rem);
  }

  .site-footer--compact :global(.wordmark),
  .site-footer--compact nav {
    display: none;
  }

  .site-footer--compact .site-footer__brand {
    max-width: none;
  }

  .site-footer--compact .site-footer__brand .site-footer__statement {
    margin-top: 0;
    color: var(--color-cream-200);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .site-footer--compact .site-footer__statement em {
    color: var(--color-mint-500);
  }

  .site-footer--compact .site-footer__brand > p:last-child {
    margin-top: var(--space-4);
    font-size: .75rem;
    line-height: 1.55;
  }

  .site-footer--compact .site-footer__bottom {
    width: min(calc(100% - 2 * var(--space-10)), 68.75rem);
    margin-top: var(--space-5);
    padding-top: 0;
    border-top: 0;
    text-align: right;
  }

  @media (max-width: 63.99rem) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
      max-width: 36rem;
    }
  }

  @media (max-width: 47.99rem) {
    .site-footer--mobile-hidden {
      display: none;
    }

    .site-footer {
      padding: var(--space-10) 0 calc(var(--space-6) + env(safe-area-inset-bottom));
    }

    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-5);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }

    .site-footer__brand p {
      font-size: .8125rem;
    }

    .site-footer__bottom {
      margin-top: var(--space-8);
    }

    .site-footer--compact {
      padding: var(--space-8) 0 calc(var(--space-6) + env(safe-area-inset-bottom));
    }

    .site-footer--compact .site-footer__grid,
    .site-footer--compact .site-footer__bottom {
      width: min(calc(100% - 2 * var(--space-5)), 68.75rem);
    }

    .site-footer--compact .site-footer__brand .site-footer__statement {
      font-size: var(--type-card-size) !important;
      line-height: var(--type-card-line) !important;
    }

    .site-footer--compact .site-footer__brand > p:last-child {
      font-size: var(--type-caption-size) !important;
      line-height: var(--type-caption-line) !important;
    }

    .site-footer--compact .site-footer__bottom {
      margin-top: var(--space-5);
      text-align: left;
    }
  }
</style>
