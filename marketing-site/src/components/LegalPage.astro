---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@config/site';

interface Props {
  documentId: 'terms' | 'privacy';
  eyebrow: string;
  heading: string;
  lede: string;
  canonicalPath: string;
}

const { documentId, eyebrow, heading, lede, canonicalPath } = Astro.props;
const document = await getEntry('legal', documentId);
if (!document) throw new Error(`Missing legal document: ${documentId}`);
const { Content } = await render(document);
const effectiveDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC'
}).format(document.data.effectiveDate);
---

<BaseLayout
  title={`${document.data.title} | BarkLens`}
  description={document.data.description}
  canonicalPath={canonicalPath}
>
  <article class="legal-page">
    <header class="legal-page__hero container">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p>{lede}</p>
      <div>
        <span>Effective {effectiveDate}</span>
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </div>
    </header>

    <div class="legal-page__layout container">
      <div class="legal-page__content">
        <Content />
        <address class="legal-page__fine-print">
          {site.legalName} d/b/a BarkLens · 7804 Fairview Rd C-162, Charlotte, NC 28226 ·
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> · United States only · Age 18+
        </address>
      </div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('.legal-page__content table').forEach((table, index) => {
    table.tabIndex = 0;
    table.setAttribute('aria-label', `Legal information table ${index + 1}`);
  });
</script>

<style>
  .legal-page {
    background: #fff;
  }

  .legal-page__hero {
    padding-block: var(--space-24) var(--space-12);
  }

  .legal-page__hero h1 {
    max-width: 15ch;
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
  }

  .legal-page__hero > p:not(.eyebrow) {
    max-width: 56ch;
    margin-top: var(--space-5);
    color: var(--color-copy-muted);
  }

  .legal-page__hero > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
    color: var(--color-green-600);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .legal-page__layout {
    padding-bottom: var(--space-24);
  }

  .legal-page__content {
    min-width: 0;
    max-width: 50rem;
    margin-inline: auto;
  }

  .legal-page__fine-print {
    margin-top: var(--space-20);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-copy-muted);
    font-size: var(--text-xs);
    font-style: normal;
    line-height: 1.7;
  }

  .legal-page__fine-print a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: .2rem;
  }

  .legal-page__content :global(h2) {
    margin-top: var(--space-20);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xl);
  }

  .legal-page__content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .legal-page__content :global(h3) {
    margin-top: var(--space-10);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .legal-page__content :global(p),
  .legal-page__content :global(ul),
  .legal-page__content :global(ol),
  .legal-page__content :global(blockquote),
  .legal-page__content :global(table) {
    margin-top: var(--space-5);
    color: var(--color-copy-muted);
  }

  .legal-page__content :global(ul),
  .legal-page__content :global(ol) {
    display: grid;
    gap: var(--space-3);
    padding-left: var(--space-6);
  }

  .legal-page__content :global(blockquote) {
    padding: var(--space-6);
    border-left: .25rem solid var(--color-mint-500);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-cream-200);
  }

  .legal-page__content :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .legal-page__content :global(a) {
    color: var(--color-green-600);
    text-decoration: underline;
    text-underline-offset: .2rem;
  }

  .legal-page__content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .legal-page__content :global(th),
  .legal-page__content :global(td) {
    min-width: 9rem;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .legal-page__content :global(th) {
    color: var(--color-copy);
    background: var(--color-cream-200);
  }

  .legal-page__content :global(hr) {
    margin-top: var(--space-16);
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 47.99rem) {
    .legal-page__hero {
      padding-block: var(--space-12) var(--space-8);
    }

    .legal-page__layout {
      padding-bottom: var(--space-16);
    }

    .legal-page__content :global(h2) {
      font-size: var(--type-subhead-size) !important;
      line-height: var(--type-subhead-line) !important;
    }

    .legal-page__content :global(h3) {
      font-size: var(--type-card-size) !important;
      line-height: 1.25 !important;
    }
  }
</style>
