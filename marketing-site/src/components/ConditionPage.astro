---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from './ButtonLink.astro';
import { routes } from '@config/site';
import type { ConditionPageData } from '../data/conditionPages';

interface Props {
  page: ConditionPageData;
}

const { page } = Astro.props;
const canonicalUrl = new URL(`/conditions/${page.slug}/`, 'https://barklens.com').href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: page.seoTitle,
  description: page.description,
  image: new URL(page.image, 'https://barklens.com').href,
  mainEntityOfPage: canonicalUrl,
  about: {
    '@type': 'Thing',
    name: page.subject
  },
  author: {
    '@type': 'Organization',
    name: 'BarkLens'
  },
  publisher: {
    '@type': 'Organization',
    name: 'BarkLens',
    url: 'https://barklens.com'
  }
};
---

<BaseLayout
  title={page.seoTitle}
  description={page.description}
  canonicalPath={`/conditions/${page.slug}/`}
  image={page.image}
  type="article"
  structuredData={articleSchema}
>
  <article class="condition-page" data-condition={page.slug}>
    <header class="condition-hero">
      <picture>
        {page.mobileImage && <source media="(max-width: 47.99rem)" srcset={page.mobileImage} />}
        <img src={page.image} alt={page.imageAlt} width="2200" height="1400" fetchpriority="high" />
      </picture>
      <div class="condition-hero__shade"></div>
      <div class="condition-hero__content container">
        <a href={routes.conditions}>← Conditions</a>
        <h1>{page.title}</h1>
        <p>{page.heroDescription}</p>
      </div>
    </header>

    <div class="condition-layout container">
      <div class="condition-content">
        <section>
          <p class="eyebrow">After diagnosis</p>
          <h2>The diagnosis is the beginning</h2>
          {page.opening.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section>
          <p class="eyebrow">The research</p>
          <h2>What published veterinary sources commonly consider</h2>
          <div class="research-list">
            {page.research.map((item) => (
              <article>
                <h3>{item.title}</h3>
                {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </article>
            ))}
          </div>
        </section>

        <section>
          <p class="eyebrow">Their complete record</p>
          <h2>See it in your dog’s history</h2>
          <p>BarkLens reads, compares, connects, and explains the information that matters to this history.</p>
          <ul class="feature-list">
            {page.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <div class="answer-demo" aria-label="Example question asked from a dog’s chart">
            <p class="answer-demo__label">Ask BarkLens from their chart</p>
            <blockquote>“{page.exampleQuestion}”</blockquote>
            <p>{page.exampleBoundary}</p>
          </div>
        </section>

        <section>
          <p class="eyebrow">Questions raised by their record</p>
          <h2>Ask from their chart</h2>
          <ul class="question-list">
            {page.questions.map((question) => <li>{question}</li>)}
          </ul>
          <p>BarkLens turns these into chart-based questions by attaching the relevant results, dates, labels, and owner observations.</p>
        </section>

        <section>
          <p class="eyebrow">Easy to share records</p>
          <h2>Bring the history with you</h2>
          {page.sharing.map((paragraph) => <p>{paragraph}</p>)}
          <div class="share-demo" aria-label="Ways to share a BarkLens history">
            <span>Show the QR</span>
            <span>Send the link</span>
            <span>Export the history</span>
          </div>
        </section>

        {page.urgent && <p class="urgent-note">{page.urgent}</p>}

        <section class="sources" id="condition-sources">
          <p class="eyebrow">Published veterinary sources</p>
          <h2>Every source reviewed by a licensed veterinarian.</h2>
          <ul>
            {page.sources.map((source) => (
              <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
            ))}
          </ul>
        </section>
      </div>

    </div>

    <section class="condition-cta">
      <div class="container">
        <h2>{page.cta}</h2>
        <ButtonLink href={routes.waitlist} variant="light">Join Waitlist</ButtonLink>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .condition-hero {
    position: relative;
    isolation: isolate;
    min-height: 42rem;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--color-copy-inverse);
  }

  .condition-hero > picture,
  .condition-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
  }

  .condition-hero > picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .condition-hero__shade {
    z-index: -1;
    background: linear-gradient(180deg, rgb(15 31 26 / 12%), rgb(15 31 26 / 88%));
  }

  .condition-hero__content {
    padding-bottom: var(--space-16);
  }

  .condition-hero__content > a {
    color: var(--color-mint-400);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .condition-hero h1 {
    max-width: 20ch;
    margin-top: var(--space-5);
    font-size: clamp(2.8rem, 5.4vw, 5rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .condition-hero__content > p {
    max-width: 66ch;
    margin-top: var(--space-6);
    color: #f2ece2;
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .condition-layout {
    display: block;
    padding-block: var(--space-20);
  }

  .condition-content {
    max-width: 49rem;
    margin-inline: auto;
  }

  .condition-content > section + section {
    margin-top: var(--space-20);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .condition-content h2 {
    max-width: 24ch;
    margin-top: var(--space-4);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .condition-content section > p {
    margin-top: var(--space-5);
    color: var(--color-copy-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .research-list {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-10);
  }

  .research-list article {
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-mint-500);
  }

  .research-list h3 {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .research-list p {
    margin-top: var(--space-3);
    color: var(--color-copy-muted);
    line-height: 1.7;
  }

  .feature-list,
  .question-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    list-style: none;
  }

  .feature-list li,
  .question-list li {
    position: relative;
    padding-left: var(--space-6);
    line-height: 1.6;
  }

  .feature-list li::before,
  .question-list li::before {
    position: absolute;
    left: 0;
    color: var(--color-green-600);
    font-weight: 700;
  }

  .feature-list li::before { content: '✓'; }
  .question-list li::before { content: '→'; }

  .answer-demo {
    margin-top: var(--space-10);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--color-forest-900);
    color: var(--color-copy-inverse);
  }

  .answer-demo__label {
    color: var(--color-mint-400);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .answer-demo blockquote {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.3;
  }

  .answer-demo > p:last-child {
    margin-top: var(--space-5);
    color: #c9c0b3;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .share-demo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .share-demo span {
    display: grid;
    min-height: 6rem;
    place-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-cream-200);
    color: var(--color-forest-900);
    font-weight: 700;
    text-align: center;
  }

  .urgent-note {
    margin-top: var(--space-16);
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-green-600);
    color: var(--color-copy-muted);
    font-weight: 600;
    line-height: 1.6;
  }

  .sources h2 {
    max-width: 19ch;
  }

  .sources ul {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
    list-style: none;
  }

  .sources a {
    color: var(--color-green-600);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .25rem;
  }

  .condition-cta {
    padding: var(--space-20) 0;
    background: var(--color-forest-900);
    color: var(--color-copy-inverse);
    text-align: center;
  }

  .condition-cta h2 {
    max-width: 21ch;
    margin-inline: auto;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .condition-cta :global(.button-link) {
    margin-top: var(--space-8);
  }

  @media (max-width: 47.99rem) {
    .condition-hero {
      min-height: 38rem;
    }

    .condition-hero__content {
      padding-bottom: var(--space-10);
    }

    .condition-hero h1 {
      max-width: none;
      font-size: clamp(2.05rem, 9vw, 2.65rem);
    }

    .condition-hero__content > p {
      font-size: 1rem;
    }

    .condition-page[data-condition='kidney-disease'] .condition-hero > picture img { object-position: 76% center; }
    .condition-page[data-condition='liver-disease'] .condition-hero > picture img { object-position: 35% center; }
    .condition-page[data-condition='pancreatitis'] .condition-hero > picture img { object-position: 64% center; transform: scale(1.25) translateY(-10%); }
    .condition-page[data-condition='cushings-disease'] .condition-hero > picture img { object-position: 70% center; }
    .condition-page[data-condition='diabetes'] .condition-hero > picture img { object-position: 55% center; }
    .condition-page[data-condition='thyroid'] .condition-hero > picture img { object-position: 62% center; transform: scale(1.25) translateY(-10%); }
    .condition-page[data-condition='heart-disease'] .condition-hero > picture img { object-position: 25% center; transform: scale(1.25) translateY(-12%); }
    .condition-page[data-condition='arthritis'] .condition-hero > picture img { object-position: 47% center; transform: scale(1.35) translateY(-10%); }

    .condition-layout {
      padding-block: var(--space-12);
    }

    .condition-content > section + section {
      margin-top: var(--space-12);
      padding-top: var(--space-12);
    }

    .condition-content h2 {
      font-size: 2.15rem;
    }

    .research-list {
      gap: var(--space-6);
    }

    .answer-demo {
      padding: var(--space-6);
    }

    .share-demo {
      grid-template-columns: 1fr;
    }

    .share-demo span {
      min-height: 3.5rem;
    }

    .condition-cta {
      padding: var(--space-16) 0;
    }
  }
</style>
