---
import ButtonLink from './ButtonLink.astro';
import Wordmark from './Wordmark.astro';
import { primaryNavigation, routes } from '@config/site';

const isWaitlistFlow = Astro.url.pathname.startsWith('/waitlist') || Astro.url.pathname.startsWith('/unsubscribe');
const isSourcesPage = Astro.url.pathname.startsWith('/where-the-answers-come-from');
const mobileActionHref = isSourcesPage ? '/#why-barklens' : isWaitlistFlow ? routes.home : routes.waitlist;
const mobileActionLabel = isSourcesPage ? '← Back to site' : isWaitlistFlow ? '← Back' : 'Save my spot';
---

<header class="site-header" data-site-header>
  <div class="site-header__inner container">
    <Wordmark />

    <nav class="site-header__desktop-nav" aria-label="Primary navigation">
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__questions" href="/#questions">Questions</a>
      <ButtonLink href={routes.waitlist}>Join Waitlist</ButtonLink>
      <a class="site-header__mobile-spot" href={mobileActionHref}>
        {mobileActionLabel}
      </a>
      <button
        class="site-header__menu-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-nav-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-navigation" id="mobile-navigation" data-mobile-navigation hidden>
  <nav aria-label="Mobile navigation">
    {primaryNavigation.map((item, index) => (
      <a href={item.href}>
        <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
      </a>
    ))}
    <a href="/#questions"><span>{String(primaryNavigation.length + 1).padStart(2, '0')}</span>Questions</a>
  </nav>
  <div class="mobile-navigation__footer">
    <ButtonLink href={routes.waitlist} variant="mint">Join Waitlist</ButtonLink>
    <div class="mobile-navigation__socials" aria-label="BarkLens social media">
      <a href="https://www.instagram.com/gobarklens/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.tiktok.com/@barklens" target="_blank" rel="noopener">TikTok</a>
      <a href="https://www.pinterest.com/gobarklens/" target="_blank" rel="noopener">Pinterest</a>
      <a href="https://www.facebook.com/profile.php?id=61586751886579" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.youtube.com/@gobarklens" target="_blank" rel="noopener">YouTube</a>
    </div>
    <a href="mailto:hello@barklens.com">hello@barklens.com</a>
  </div>
</div>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-nav-toggle]');
    const menu = document.querySelector('[data-mobile-navigation]');
    if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    const closeMenu = () => {
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', 'Open navigation');
      menu.hidden = true;
      document.body.dataset.navOpen = 'false';
    };

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      if (open) {
        closeMenu();
        return;
      }
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', 'Close navigation');
      menu.hidden = false;
      document.body.dataset.navOpen = 'true';
    });

    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(1rem);
  }

  .site-header__inner {
    display: grid;
    min-height: var(--header-height);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .site-header__desktop-nav,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__desktop-nav {
    gap: var(--space-8);
  }

  .site-header__desktop-nav a,
  .site-header__questions {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-header__desktop-nav a:hover,
  .site-header__questions:hover {
    color: var(--color-green-600);
  }

  .site-header__actions {
    justify-content: flex-end;
    gap: var(--space-6);
  }

  .site-header__menu-button {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-forest-900);
  }

  .site-header__mobile-spot {
    display: none;
  }

  .site-header__menu-button span {
    display: block;
    width: 1.125rem;
    height: 1px;
    margin: 0.3rem auto;
    background: #fff;
    transition: transform var(--transition);
  }

  .site-header__menu-button[aria-expanded='true'] span:first-child {
    transform: translateY(0.2rem) rotate(45deg);
  }

  .site-header__menu-button[aria-expanded='true'] span:last-child {
    transform: translateY(-0.2rem) rotate(-45deg);
  }

  .mobile-navigation {
    position: fixed;
    z-index: 90;
    inset: var(--header-height) 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-8) var(--space-6);
    background: var(--color-cream-200);
  }

  .mobile-navigation[hidden] {
    display: none;
  }

  .mobile-navigation nav {
    display: grid;
  }

  .mobile-navigation nav a {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    gap: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .mobile-navigation nav span {
    color: var(--color-green-600);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .mobile-navigation__footer {
    display: grid;
    gap: var(--space-5);
  }

  .mobile-navigation__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-5);
    color: var(--color-copy-muted);
    font-size: var(--text-xs);
  }

  .mobile-navigation__footer > a:last-child {
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .site-header__desktop-nav,
    .site-header__questions,
    .site-header__actions :global(.button-link) {
      display: none;
    }

    .site-header__menu-button {
      display: block;
    }
  }

  @media (max-width: 47.99rem) {
    .site-header {
      min-height: 3.25rem;
      border-color: rgb(237 227 212 / 10%);
      background: rgb(11 11 12 / 96%);
    }

    .site-header__inner {
      min-height: 3.25rem;
      gap: var(--space-4);
    }

    .site-header :global(.wordmark) {
      width: 6.25rem;
      color: var(--color-copy-inverse);
    }

    .site-header__actions {
      gap: var(--space-4);
    }

    .site-header__mobile-spot {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      color: var(--color-cream-300);
      font-size: .75rem;
      font-weight: 600;
    }

    .site-header__menu-button {
      width: 2.75rem;
      height: 2.75rem;
      background: transparent;
    }

    .mobile-navigation {
      inset: 3.25rem 0 0;
      padding: var(--space-6) var(--space-5) calc(var(--space-6) + env(safe-area-inset-bottom));
      background: var(--color-forest-950);
      color: var(--color-copy-inverse);
    }

    .mobile-navigation nav a {
      border-color: rgb(237 227 212 / 16%);
    }

    .mobile-navigation nav span,
    .mobile-navigation__socials {
      color: var(--color-mint-500);
    }
  }
</style>
