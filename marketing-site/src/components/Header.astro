---
import ButtonLink from './ButtonLink.astro';
import Wordmark from './Wordmark.astro';
import { primaryNavigation, routes } from '@config/site';
---

<header class="site-header" data-site-header>
  <div class="site-header__inner container">
    <Wordmark />

    <nav class="site-header__desktop-nav" aria-label="Primary navigation">
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__questions" href="/#questions">Questions</a>
      <ButtonLink href={routes.waitlist}>Join Waitlist</ButtonLink>
      <button
        class="site-header__menu-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-nav-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-navigation" id="mobile-navigation" data-mobile-navigation hidden>
  <nav aria-label="Mobile navigation">
    {primaryNavigation.map((item, index) => (
      <a href={item.href}>
        <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
      </a>
    ))}
    <a href="/#questions"><span>06</span>Questions</a>
  </nav>
  <div class="mobile-navigation__footer">
    <ButtonLink href={routes.waitlist} variant="mint">Join Waitlist</ButtonLink>
    <a href="mailto:hello@barklens.com">hello@barklens.com</a>
  </div>
</div>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-nav-toggle]');
    const menu = document.querySelector('[data-mobile-navigation]');
    if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    const closeMenu = () => {
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', 'Open navigation');
      menu.hidden = true;
      document.body.dataset.navOpen = 'false';
    };

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      if (open) {
        closeMenu();
        return;
      }
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', 'Close navigation');
      menu.hidden = false;
      document.body.dataset.navOpen = 'true';
    });

    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(1rem);
  }

  .site-header__inner {
    display: grid;
    min-height: var(--header-height);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .site-header__desktop-nav,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__desktop-nav {
    gap: var(--space-8);
  }

  .site-header__desktop-nav a,
  .site-header__questions {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-header__desktop-nav a:hover,
  .site-header__questions:hover {
    color: var(--color-green-600);
  }

  .site-header__actions {
    justify-content: flex-end;
    gap: var(--space-6);
  }

  .site-header__menu-button {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-forest-900);
  }

  .site-header__menu-button span {
    display: block;
    width: 1.125rem;
    height: 1px;
    margin: 0.3rem auto;
    background: #fff;
    transition: transform var(--transition);
  }

  .site-header__menu-button[aria-expanded='true'] span:first-child {
    transform: translateY(0.2rem) rotate(45deg);
  }

  .site-header__menu-button[aria-expanded='true'] span:last-child {
    transform: translateY(-0.2rem) rotate(-45deg);
  }

  .mobile-navigation {
    position: fixed;
    z-index: 90;
    inset: var(--header-height) 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-8) var(--space-6);
    background: var(--color-cream-200);
  }

  .mobile-navigation[hidden] {
    display: none;
  }

  .mobile-navigation nav {
    display: grid;
  }

  .mobile-navigation nav a {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    gap: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .mobile-navigation nav span {
    color: var(--color-green-600);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .mobile-navigation__footer {
    display: grid;
    gap: var(--space-5);
  }

  .mobile-navigation__footer > a:last-child {
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .site-header__desktop-nav,
    .site-header__questions,
    .site-header__actions :global(.button-link) {
      display: none;
    }

    .site-header__menu-button {
      display: block;
    }
  }
</style>
