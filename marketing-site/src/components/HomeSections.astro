---
import ButtonLink from './ButtonLink.astro';
import { routes } from '@config/site';
import {
  captureItems,
  conditions,
  faqs,
  howItWorksSteps,
  whyItems
} from '../data/home';

const mobileStepImages = [
  '/images/mobile/how-add.webp',
  '/images/mobile/how-ask.webp',
  '/images/mobile/how-answers.webp'
];

const mobileCaptureLabels = ['Labs', 'Medication', 'Supplement', 'Food', 'Home-cooked', 'Stool'];
const mobileCaptureImages = [
  '/images/mobile/capture-lab.webp',
  '/images/mobile/capture-medication.webp',
  '/images/mobile/capture-supplement.webp',
  '/images/mobile/capture-food.webp',
  '/images/mobile/capture-home-cooked.webp',
  '/images/mobile/capture-stool.webp'
];

const mobileWhyItems = [
  { number: '01', title: 'The BarkLens Standard', label: 'Reviewed sources', href: routes.sources },
  { number: '02', title: 'Easy to Share Records', label: 'Vet export', href: routes.records },
  { number: '03', title: 'Your Team', label: 'Care team', href: routes.careTeam }
];

---

<section class="how section" id="how-it-works">
  <div class="container">
    <p class="section-label">How it works</p>
    <div class="how__grid">
      {howItWorksSteps.map((step, index) => (
        <article class="how__step">
          <picture>
            <source media="(max-width: 47.99rem)" srcset={mobileStepImages[index]} />
            <img src={step.image} alt={step.alt} width="1122" height="1402" loading="lazy" />
          </picture>
          <p class="number-label">Step {step.number}</p>
          <h2>{step.title}</h2>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="closer section section--image">
  <img src="/images/home/closer-look.webp" alt="" width="2200" height="1300" loading="lazy" />
  <div class="image-shade"></div>
  <div class="closer__content container">
    <div class="closer__intro">
      <p class="section-label section-label--light">Connect Their Dots</p>
      <h2 class="closer__desktop-title">Brings together the pieces of your dog’s chart <em>you might not think to connect.</em></h2>
      <h2 class="closer__mobile-title">Brings together the pieces of your dog’s story <em>you might not think to connect.</em></h2>
      <p class="closer__desktop-copy">Something you noticed today. A lab value from months ago. A medication change from March.</p>
      <p class="closer__desktop-answer">
        Increased thirst, a BUN above range, and a steroid started in March are worth mentioning
        together at Charlie’s next visit.
      </p>
    </div>
    <article class="chart-card">
      <p class="number-label">Closer Look</p>
      <dl>
        <div><dt>“Drinking more than usual”</dt><dd>Jun 20</dd></div>
        <div><dt>BUN 32 mg/dL · <span class="chart-card__range">range 7–27</span></dt><dd>Jun 3</dd></div>
        <div><dt>Prednisone started</dt><dd>Mar 3</dd></div>
      </dl>
      <div class="chart-card__prompt"><span>Ask about these…</span><b aria-hidden="true">↑</b></div>
    </article>
    <div class="closer__mobile-copy">
      <p>Closer Look brings them together from across your dog’s chart, because published veterinary research says they belong in the same conversation.</p>
      <p>Something you noticed today. A lab value from months ago. A medication change from March.</p>
    </div>
  </div>
</section>

<section class="capture section" id="capture" data-capture data-capture-phase="done">
  <div class="container">
    <div class="capture__grid">
      <div class="capture__copy">
        <p class="section-label">Snap a picture</p>
        <h2><em>You snap it. We explain it</em> using your dog’s history and published veterinary research.</h2>
        <div class="capture__tabs" role="tablist" aria-label="Record types">
          {captureItems.map((item, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`capture-panel-${index}`}
              id={`capture-tab-${index}`}
              data-capture-tab={index}
            >
              <span aria-hidden="true"></span>
              <strong>{item.label}</strong>
              <b class="capture__mobile-label">{mobileCaptureLabels[index]}</b>
              <small>{item.blurb}</small>
            </button>
          ))}
        </div>
      </div>
      <div class="capture__device-wrap">
        <div class="capture__phone">
          <i class="capture__side capture__side--mute"></i>
          <i class="capture__side capture__side--up"></i>
          <i class="capture__side capture__side--down"></i>
          <i class="capture__side capture__side--power"></i>
          <i class="capture__notch"></i>
          <div class="capture__display">
            {captureItems.map((item, index) => (
              <div
                id={`capture-panel-${index}`}
                role="tabpanel"
                aria-labelledby={`capture-tab-${index}`}
                data-capture-panel={index}
                hidden={index !== 0}
              >
                <picture>
                  <source media="(max-width: 47.99rem)" srcset={mobileCaptureImages[index]} />
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </picture>
                <div class="capture__scrim"></div>
                <div class="capture__aim" aria-hidden="true">
                  <span></span><span></span><span></span><span></span>
                </div>
                <div class="capture__flash" aria-hidden="true"></div>
                <div class="capture__heading">
                  <p>{item.eyebrow}</p>
                  <span>{item.caption}</span>
                </div>
                {index === 0 ? (
                  <div class="capture__result capture__result--lab">
                    <p class="capture__card-label">Labs</p>
                    <div class="capture__lab-chart" aria-label="ALT values increased from 62 to 78 to 95 to 118 units per liter">
                      <div class="capture__lab-range"></div>
                      {[
                        ['62', 'Aug ’25', '27'],
                        ['78', 'Nov ’25', '34'],
                        ['95', 'Feb ’26', '42'],
                        ['118', 'Jun ’26', '52']
                      ].map(([value, date, height], barIndex) => (
                        <div class:list={['capture__lab-bar', { 'capture__lab-bar--latest': barIndex === 3 }]}>
                          <b>{value}</b>
                          <i style={`--bar-height:${height}px`}></i>
                          <span>{date}</span>
                        </div>
                      ))}
                    </div>
                    <p class="capture__lab-caption">ALT · U/L · Lab range 10–100</p>
                    <div class="capture__lab-legend">
                      <span><i></i>In range</span>
                      <span><i></i>Out of range</span>
                    </div>
                    <div class="capture__ask"><span>Ask about this…</span><b aria-hidden="true">↑</b></div>
                  </div>
                ) : (
                  <div class="capture__result capture__result--chat">
                    <p class="capture__card-label">Chat</p>
                    <div class="capture__sent">
                      <p>Photo sent · {item.label}</p>
                      <small>Delivered</small>
                    </div>
                    <div class="capture__reply">
                      <b aria-hidden="true">B</b>
                      <div>
                        <div class="capture__reply-copy">
                          {item.rows.map((row) => <p>{row}</p>)}
                        </div>
                        <small>BarkLens · Just now</small>
                      </div>
                    </div>
                    <div class="capture__ask"><span>Ask about this…</span><b aria-hidden="true">↑</b></div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trends section section--image" id="trends">
  <img class="trends__desktop-image" src="/images/home/trends.webp" alt="" width="1536" height="1024" loading="lazy" />
  <img class="trends__mobile-image" src="/images/mobile/trends-dog.webp" alt="" width="900" height="1495" loading="lazy" />
  <div class="image-shade image-shade--soft"></div>
  <div class="trends__grid container">
    <div class="trends__copy">
      <p class="section-label section-label--light">Trends</p>
      <h2 class="trends__desktop-title">Every result was ‘in range.’ <em>Together, they told a different story.</em></h2>
      <h2 class="trends__mobile-title">Every result was ‘in range.’ <em>Together, they told a different story.</em></h2>
      <p class="trends__desktop-copy">
        A single lab result is one moment. BarkLens puts every draw in one view so you can see the
        change — and walk into the next visit with it.
      </p>
      <blockquote>Because the more of their story you can see, the better you can show up for them.</blockquote>
    </div>
    <article class="trend-card">
      <p class="number-label trend-card__label">Labs</p>
      <svg viewBox="0 0 520 192" role="img" aria-label="BUN results increased from 19 to 23 to 27 milligrams per deciliter across three draws, all within the reported range of 7 to 27">
        <rect x="56" y="26" width="452" height="120" rx="6" fill="#2f3533" />
        <line x1="56" y1="26" x2="508" y2="26" stroke="#7d8581" stroke-width="1" stroke-dasharray="4 5" />
        <line x1="56" y1="146" x2="508" y2="146" stroke="#454e4b" />
        <text x="36" y="31" text-anchor="end">27</text><text x="36" y="150" text-anchor="end">7</text>
        <rect x="92" y="74" width="76" height="72" rx="5" /><rect x="248" y="50" width="76" height="96" rx="5" /><rect x="404" y="26" width="76" height="120" rx="5" />
        <text class="value" x="130" y="65">19</text><text class="value" x="286" y="41">23</text><text class="value" x="442" y="18">27</text>
        <text class="date" x="130" y="178">JUN ’24</text><text class="date" x="286" y="178">JAN ’25</text><text class="date date--latest" x="442" y="178">JUN ’25</text>
      </svg>
      <p class="trend-card__caption">BUN · mg/dL · Range 7–27 · Three draws</p>
      <div class="trend-card__ask"><span>Ask about this trend…</span><b aria-hidden="true">↑</b></div>
    </article>
    <div class="trends__mobile-copy">
      <p>A single lab result is one moment. BarkLens puts every draw in one view so you can see the change — and walk into the next visit with it.</p>
    </div>
  </div>
</section>

<section class="why section" id="why-barklens">
  <div class="container">
    <p class="section-label">Why BarkLens</p>
    <h2>What sets us <em>apart</em></h2>
    <div class="why__grid why__grid--desktop">
      {whyItems.map((item) => (
        <a href={item.href}>
          <span>{item.number}</span>
          <div><h3>{item.title}</h3><p>{item.body}</p></div>
        </a>
      ))}
    </div>
    <div class="why__mobile-list">
      {mobileWhyItems.map((item) => (
        <a href={item.href}>
          <span>{item.number}</span>
          <span><strong>{item.title}</strong><small>{item.label}</small></span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="story section section--image">
  <img class="story__desktop-image" src="/images/home/charlie.webp" alt="" width="1774" height="887" loading="lazy" />
  <img class="story__mobile-image" src="/images/mobile/charlie-story.webp" alt="" width="3024" height="4032" loading="lazy" />
  <div class="image-shade"></div>
  <div class="story__content container">
    <p class="section-label section-label--light">Our story</p>
    <h2>Built for one dog. <em>Made for yours.</em></h2>
    <p>
      Charlie was a rescue with a complicated medical history from the start. Over 16.5 years we
      lived with chronic conditions, flare-ups, and the wish for more help before and after his vet
      appointments.
    </p>
    <p>
      BarkLens is the thing I wished for in every waiting room. I’m building it so you have it for
      yours.
    </p>
    <a href={routes.charlieStory}>Read the full story →</a>
    <small>Ben Singer, Founder · Charlie, 2009–2025</small>
  </div>
</section>

<section class="conditions section" id="conditions">
  <div class="container">
    <p class="section-label">After diagnosis</p>
    <div class="conditions__intro">
      <h2>A diagnosis is not the whole story.</h2>
      <div>
        <p>
          You don’t have to become a veterinarian overnight. BarkLens helps you understand the
          condition, the labs, the medication, and what to watch between visits — so you can manage
          care from knowledge, not from panic.
        </p>
        <a href={routes.conditions}>Read the conditions guide →</a>
      </div>
    </div>
    <div class="conditions__grid">
      {conditions.map((condition) => (
        <a href={condition.href}>
          <h3>{condition.title}</h3>
          <p>{condition.clue}</p>
          <span>{condition.tag}</span>
          <b>Read →</b>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="faq section" id="questions" data-faq>
  <div class="faq__inner container">
    <div>
      <p class="section-label">Frequently asked questions</p>
      <h2>How BarkLens works</h2>
    </div>
    <div class="faq__list">
      {faqs.map((item, index) => (
        <article>
          <h3>
            <button type="button" aria-expanded="false" aria-controls={`faq-answer-${index}`} data-faq-button>
              <span>{item.question}</span><b aria-hidden="true">+</b>
            </button>
          </h3>
          <div id={`faq-answer-${index}`} data-faq-answer hidden><p>{item.answer}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="closing section--image">
  <img class="closing__desktop-image" src="/images/home/internet-knows-dogs.webp" alt="An owner standing beside their dog on a rocky shoreline" width="2200" height="1237" loading="lazy" />
  <img class="closing__mobile-image" src="/images/home/internet-knows-dogs.webp" alt="An owner standing beside their dog on a rocky shoreline" width="2200" height="1237" loading="lazy" />
  <div class="image-shade"></div>
  <div class="closing__content">
    <h2>The internet knows dogs. <em>BarkLens knows yours.</em></h2>
    <p>Try it free. Bring your dog’s records into one place.</p>
    <ButtonLink href={routes.waitlist} variant="light">Join Waitlist</ButtonLink>
    <small>Seven-day free trial.</small>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-capture]').forEach((root) => {
      const tabs = [...root.querySelectorAll('[data-capture-tab]')];
      const panels = [...root.querySelectorAll('[data-capture-panel]')];
      let active = 0;
      let automatic = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let aimTimer;
      let doneTimer;
      let cycleTimer;
      let entered = false;
      const phoneLayout = window.matchMedia('(max-width: 47.99rem)');
      const preloadPanels = () => panels.forEach((panel) => {
        const source = panel.querySelector('source');
        const image = panel.querySelector('img');
        const preload = new Image();
        preload.src = phoneLayout.matches && source?.srcset ? source.srcset : image?.currentSrc || image?.src || '';
      });
      if ('IntersectionObserver' in window) {
        const preloadObserver = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          preloadPanels();
          preloadObserver.disconnect();
        }, { rootMargin: '400px' });
        preloadObserver.observe(root);
      } else {
        preloadPanels();
      }
      const select = (index, animate = false) => {
        window.clearTimeout(aimTimer);
        window.clearTimeout(doneTimer);
        active = index;
        tabs.forEach((tab, i) => tab.setAttribute('aria-selected', String(i === index)));
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
        if (animate) {
          root.dataset.capturePhase = 'aim';
          aimTimer = window.setTimeout(() => { root.dataset.capturePhase = 'flash'; }, 780);
          doneTimer = window.setTimeout(() => { root.dataset.capturePhase = 'done'; }, 1010);
        } else {
          root.dataset.capturePhase = 'done';
        }
      };
      const stopCycle = () => {
        window.clearInterval(cycleTimer);
        cycleTimer = undefined;
      };
      const startCycle = () => {
        if (!automatic || cycleTimer) return;
        cycleTimer = window.setInterval(() => {
          select((active + 1) % tabs.length, true);
        }, 4200);
      };
      tabs.forEach((tab, index) => tab.addEventListener('click', () => {
        automatic = false;
        stopCycle();
        select(index, true);
      }));
      if ('IntersectionObserver' in window) {
        const cycleObserver = new IntersectionObserver((entries) => {
          const visible = entries.some((entry) => entry.isIntersecting);
          if (!visible) {
            stopCycle();
            return;
          }
          if (!entered && automatic) {
            entered = true;
            select(0, true);
          }
          startCycle();
        }, { threshold: .25 });
        cycleObserver.observe(root);
      } else if (automatic) {
        entered = true;
        select(0, true);
        startCycle();
      }
    });

    document.querySelectorAll('[data-faq-button]').forEach((button) => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const answer = document.getElementById(button.getAttribute('aria-controls'));
        button.setAttribute('aria-expanded', String(!expanded));
        if (answer) answer.hidden = expanded;
      });
    });

  })();
</script>

<style>
  .section { padding: var(--space-24) 0; }
  .section-label, .number-label { color: var(--color-green-600); font-size: var(--text-xs); font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .section-label--light { color: var(--color-mint-400); }
  h2 { font-size: var(--text-xl); }
  h2 em { color: var(--color-green-600); font-weight: 400; }
  .section--image { position: relative; isolation: isolate; overflow: hidden; color: var(--color-copy-inverse); }
  .section--image > img, .image-shade { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .image-shade { z-index: -1; background: linear-gradient(90deg, rgb(10 25 20 / 88%), rgb(10 25 20 / 54%) 45%, rgb(10 25 20 / 16%)); }
  .image-shade--soft { background: rgb(10 25 20 / 53%); }

  .how__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); margin-top: var(--space-16); }
  .how__step picture { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-cream-200); }
  .how__step img { width: 100%; height: 100%; border-radius: 0; object-fit: cover; object-position: 50% 50%; }
  .how__step .number-label { margin-top: var(--space-6); }
  .how__step h2 { margin-top: var(--space-3); font-size: var(--text-lg); }
  .how__step > p:last-child { margin-top: var(--space-3); color: var(--color-copy-muted); }

  .closer { min-height: 48rem; display: grid; align-items: center; }
  .closer__content, .trends__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(28rem, .9fr); align-items: center; gap: var(--space-16); }
  .closer__intro h2, .trends h2 { max-width: 18ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .closer__intro h2 em, .trends h2 em { display: block; color: var(--color-mint-400); font-weight: 400; }
  .closer__intro > p:not(.section-label), .trends__grid > div > p:not(.section-label) { margin-top: var(--space-6); font-size: var(--text-lg); }
  .closer__desktop-answer { max-width: 38ch; }
  .closer__mobile-title { display: none; }
  .closer__mobile-copy { display: none; }
  .chart-card { display: flex; height: 23.5rem; flex-direction: column; overflow: hidden; padding: 0; border: 1px solid rgb(255 255 255 / 28%); border-radius: var(--radius-xl); background: #29272d; box-shadow: var(--shadow-card); }
  .chart-card > .number-label { padding: .875rem 1rem; border-bottom: 1px solid rgb(255 255 255 / 14%); color: var(--color-cream-100); }
  .chart-card dl { display: flex; flex: 1; flex-direction: column; padding: 0 1rem; }
  .chart-card dl div { display: grid; flex: 1; align-content: center; gap: .25rem; padding: .875rem 0; border-bottom: 1px solid rgb(255 255 255 / 16%); }
  .chart-card dd { color: #a9bdb6; font-size: .6875rem; }
  .chart-card__range { color: #c08a72; }
  .chart-card__prompt { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin: .875rem; padding: .375rem .375rem .375rem .875rem; border: 1px solid rgb(255 255 255 / 25%); border-radius: var(--radius-pill); color: #9eaaa5; font-size: .8125rem; }
  .chart-card__prompt b { display: grid; width: 1.75rem; height: 1.75rem; flex: 0 0 auto; place-items: center; border-radius: 50%; color: var(--color-forest-950); background: var(--color-mint-500); }

  .capture { display: flex; min-height: 75rem; align-items: center; padding: 3.75rem 0; background: var(--color-cream-200); }
  .capture__grid { display: grid; grid-template-columns: minmax(0, 1fr) 35rem; gap: 4rem; align-items: stretch; }
  .capture__copy > h2 { max-width: 18ch; margin-top: 2.5rem; font-size: 3.5rem; line-height: 1.06; }
  .capture__copy > h2 em { color: var(--color-green-600); }
  .capture__tabs { display: flex; max-width: 32.5rem; flex-direction: column; margin-top: 2.5rem; border-top: 1px solid var(--color-border); }
  .capture__tabs button { display: grid; grid-template-columns: 3px 1fr; gap: 0 1.375rem; padding: 1.125rem 0; border-bottom: 1px solid var(--color-border); background: transparent; text-align: left; cursor: pointer; }
  .capture__tabs button > span { grid-row: 1 / 3; border-radius: 2px; background: transparent; transition: background var(--transition); }
  .capture__tabs button[aria-selected='true'] > span { background: var(--color-green-600); }
  .capture__tabs button strong { color: #8e867a; font-family: var(--font-display); font-size: 1.875rem; line-height: 1.1; font-weight: 400; transition: color var(--transition); }
  .capture__tabs button[aria-selected='true'] strong { color: var(--color-copy); }
  .capture__mobile-label { display: none; }
  .capture__tabs button small { max-height: 0; overflow: hidden; color: var(--color-copy-muted); font-size: .90625rem; line-height: 1.5; opacity: 0; transition: all .4s ease; }
  .capture__tabs button[aria-selected='true'] small { max-height: 3.75rem; margin-top: .375rem; opacity: 1; }
  .capture__device-wrap { display: flex; align-items: center; justify-content: center; }
  .capture__phone { position: relative; width: 25rem; height: 51.25rem; padding: .75rem; border-radius: 3.75rem; background: #0b0b0c; box-shadow: 0 40px 80px rgb(20 32 28 / 28%), inset 0 0 0 2px #3a3a3e; }
  .capture__side, .capture__notch { position: absolute; z-index: 20; display: block; background: #0b0b0c; }
  .capture__side { width: 3px; border-radius: 2px; background: #2a2a2e; }
  .capture__side--mute { top: 9.375rem; left: -3px; height: 2.125rem; }
  .capture__side--up { top: 12.5rem; left: -3px; height: 4rem; }
  .capture__side--down { top: 17.25rem; left: -3px; height: 4rem; }
  .capture__side--power { top: 14.375rem; right: -3px; height: 6.25rem; }
  .capture__notch { top: 1.5625rem; left: 50%; width: 7.625rem; height: 2.1875rem; border-radius: 1.25rem; transform: translateX(-50%); }
  .capture__display { position: relative; height: 100%; overflow: hidden; border-radius: 3rem; background: #101312; }
  .capture__display [data-capture-panel] { position: relative; height: 100%; overflow: hidden; background: var(--color-forest-900); color: var(--color-copy-inverse); }
  .capture__display [data-capture-panel][hidden] { display: none; }
  .capture__display picture, .capture__display img, .capture__scrim { position: absolute; inset: 0; width: 100%; height: 100%; }
  .capture__display img { object-fit: cover; }
  .capture__display [data-capture-panel]:nth-child(1) img { object-position: 50% 96%; }
