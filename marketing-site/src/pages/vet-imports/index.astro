---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';

const recordTypes = [
  ['Lab reports', 'Keep every value beside the range printed on the original report.'],
  ['Visit summaries', 'Preserve the date, clinic, notes, and follow-up instructions together.'],
  ['Medication labels', 'Keep the drug name, printed directions, and label warnings with the history.'],
  ['Food and supplement labels', 'Save the ingredients and serving information exactly as printed.'],
  ['Photos and observations', 'Add what you noticed at home with the date it happened.']
];
---

<BaseLayout
  title="Vet Record Imports — BarkLens"
  description="Upload reports, labels, and photos. Review what BarkLens reads before anything joins your dog’s organized history."
  canonicalPath="/vet-imports/"
  image="/images/home/step-add-record.webp"
>
  <article class="imports-page">
    <header class="imports-hero">
      <div class="imports-hero__grid container">
        <div>
          <p class="eyebrow">Vet imports</p>
          <h1>The records already exist. <em>Bring them together.</em></h1>
          <p>Upload reports, labels, and photos. Review what BarkLens reads before anything joins your dog’s organized history.</p>
          <ButtonLink href={routes.waitlist}>Join Waitlist</ButtonLink>
          <p class="imports-boundary">BarkLens doesn’t diagnose. Your vet does.</p>
        </div>
        <picture>
          <img
            src="/images/home/step-add-record.webp"
            alt="An owner photographing a veterinary report while their dog rests nearby"
            width="1122"
            height="1402"
            fetchpriority="high"
          />
        </picture>
      </div>
    </header>

    <section class="imports-steps container">
      <div class="imports-heading">
        <p class="eyebrow">Three steps</p>
        <h2>The document leads. <em>You decide what stays.</em></h2>
      </div>
      <ol>
        <li>
          <span>01</span>
          <h3>Add the original.</h3>
          <p>Choose a PDF or photograph a report, visit summary, or label.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Review what BarkLens read.</h3>
          <p>Names, dates, values, ranges, and printed directions are shown for your review.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Confirm the record.</h3>
          <p>You approve the information before it becomes part of your dog’s chart.</p>
        </li>
      </ol>
    </section>

    <section class="imports-types">
      <div class="container">
        <div class="imports-heading">
          <p class="eyebrow">What you can add</p>
          <h2>One history, built from <em>the records you already have.</em></h2>
        </div>
        <div class="imports-types__grid">
          {recordTypes.map(([title, body], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="imports-control">
      <div class="imports-control__grid container">
        <div>
          <p class="eyebrow">Your approval</p>
          <h2>Nothing joins the chart <em>until you confirm it.</em></h2>
        </div>
        <div>
          <p>BarkLens keeps the original file beside the information it reads, so the source remains available when you return to the record.</p>
          <p>Need to carry the history somewhere else? Your records remain yours.</p>
          <a href={routes.records}>See how export works →</a>
        </div>
      </div>
    </section>

    <section class="imports-cta">
      <div class="container">
        <p class="eyebrow">Your dog’s history, in your hands.</p>
        <h2>Start with the report <em>already in front of you.</em></h2>
        <ButtonLink href={routes.waitlist} variant="light">Join Waitlist</ButtonLink>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .imports-hero { padding: var(--space-20) 0; background: var(--color-cream-200); }
  .imports-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) 28rem; gap: var(--space-20); align-items: center; }
  .imports-hero h1 { max-width: 12ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .imports-hero h1 em, .imports-heading h2 em, .imports-control h2 em, .imports-cta h2 em { color: var(--color-green-600); }
  .imports-hero__grid > div > p:not(.eyebrow) { max-width: 44ch; margin-top: var(--space-6); color: var(--color-copy-muted); font-size: var(--text-lg); }
  .imports-hero :global(.button-link) { margin-top: var(--space-8); }
  .imports-hero .imports-boundary { margin-top: var(--space-5); font-size: var(--text-sm); font-style: italic; }
  .imports-hero picture { overflow: hidden; border-radius: var(--radius-xl); background: var(--color-cream-100); box-shadow: var(--shadow-card); }
  .imports-hero img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  .imports-steps { padding-block: var(--space-20); }
  .imports-heading h2 { max-width: 15ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .imports-steps ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); margin-top: var(--space-12); list-style: none; }
  .imports-steps li { padding: var(--space-8); border-top: 1px solid var(--color-border); }
  .imports-steps li > span, .imports-types article > span { color: var(--color-green-600); font-size: var(--text-xs); font-weight: 700; letter-spacing: .12em; }
  .imports-steps h3, .imports-types h3 { margin-top: var(--space-8); font-size: var(--text-xl); }
  .imports-steps li p, .imports-types article p { margin-top: var(--space-4); color: var(--color-copy-muted); }

  .imports-types { padding-block: var(--space-20); background: var(--color-forest-900); color: var(--color-copy-inverse); }
  .imports-types .eyebrow { color: var(--color-mint-400); }
  .imports-types .imports-heading h2 em { color: var(--color-mint-400); }
  .imports-types__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin-top: var(--space-12); }
  .imports-types article { padding: var(--space-8); border: 1px solid rgb(255 255 255 / 18%); border-radius: var(--radius-lg); }
  .imports-types article > span { color: var(--color-mint-400); }
  .imports-types article p { color: #d8cfc0; }

  .imports-control { padding-block: var(--space-20); background: var(--color-cream-200); }
  .imports-control__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-20); }
  .imports-control h2 { max-width: 14ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .imports-control__grid > div:last-child { padding-top: var(--space-8); }
  .imports-control__grid > div:last-child p + p { margin-top: var(--space-5); }
  .imports-control__grid > div:last-child p { color: var(--color-copy-muted); }
  .imports-control a { display: inline-block; margin-top: var(--space-6); color: var(--color-green-600); font-weight: 700; }

  .imports-cta { padding-block: var(--space-20); background: var(--color-forest-900); color: var(--color-copy-inverse); text-align: center; }
  .imports-cta .eyebrow { color: var(--color-mint-400); }
  .imports-cta h2 { max-width: 16ch; margin: var(--space-5) auto 0; font-size: var(--text-2xl); }
  .imports-cta h2 em { color: var(--color-mint-400); }
  .imports-cta :global(.button-link) { margin-top: var(--space-8); }

  @media (max-width: 63.99rem) {
    .imports-hero__grid, .imports-control__grid { grid-template-columns: 1fr; }
    .imports-hero picture { max-width: 32rem; }
  }

  @media (max-width: 47.99rem) {
    .imports-hero { padding: var(--space-12) 0; }
    .imports-hero__grid { gap: var(--space-10); }
    .imports-hero h1, .imports-heading h2, .imports-control h2, .imports-cta h2 { font-size: var(--type-section-size); line-height: var(--type-section-line); }
    .imports-hero__grid > div > p:not(.eyebrow) { font-size: var(--type-body-size); line-height: var(--type-body-line); }
    .imports-hero picture { width: 100%; }
    .imports-steps, .imports-types, .imports-control, .imports-cta { padding-block: var(--space-16); }
    .imports-steps ol, .imports-types__grid { grid-template-columns: 1fr; margin-top: var(--space-8); }
    .imports-steps li, .imports-types article { padding: var(--space-6); }
    .imports-steps h3, .imports-types h3 { font-size: var(--type-card-size); line-height: var(--type-card-line); }
    .imports-control__grid { gap: var(--space-8); }
    .imports-control__grid > div:last-child { padding-top: 0; }
  }
</style>
