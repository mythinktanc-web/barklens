---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const categories = [
  'All',
  'Labs and Reports',
  'Medications and Labels',
  'Food and Nutrition',
  'Conditions',
  'Veterinary Visit Preparation'
];

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.sourcesVerified))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).format(date);
---

<BaseLayout
  title="Dog Health Blog — BarkLens"
  description="Plain-English explanations of canine lab values, medications, and conditions — each traced to a published source."
  canonicalPath="/blog/"
>
  <header class="blog-hero">
    <img src="/images/support/blog-1.webp" alt="A dog and their owner walking together on a quiet mountain path" width="1312" height="1600" />
    <div class="blog-hero__shade"></div>
    <div class="blog-hero__content container">
      <p class="eyebrow">Dog health blog</p>
      <h1>Read the record. <em>Bring the better question.</em></h1>
      <p>Plain-English articles about reports, labels, conditions, and veterinary visits, with the sources kept visible.</p>
    </div>
  </header>

  <section class="blog-library container" data-blog-library>
    <div class="blog-library__heading">
      <div>
        <p class="eyebrow">The library</p>
        <h2>Start with what is in front of you.</h2>
      </div>
      <p>{posts.length} {posts.length === 1 ? 'article' : 'articles'} published</p>
    </div>

    <div class="blog-filters" aria-label="Filter articles by category">
      {categories.map((category, index) => (
        <button
          type="button"
          data-blog-filter={category}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {category}
        </button>
      ))}
    </div>

    <div class="blog-grid">
      {posts.map((post, index) => (
        <article data-blog-card data-category={post.data.category} class:list={{ 'blog-card--feature': index === 0 }}>
          <a href={`/blog/${post.id}/`}>
            <img src={post.data.coverImage} alt={post.data.coverAlt} loading={index === 0 ? 'eager' : 'lazy'} />
            <div>
              <p class="eyebrow">{post.data.category}</p>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <footer>
                <span>{post.data.author}</span>
                <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
              </footer>
            </div>
          </a>
        </article>
      ))}
    </div>

    <p class="blog-empty" data-blog-empty hidden>No published articles in this category yet.</p>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-blog-library]').forEach((library) => {
    const filters = [...library.querySelectorAll('[data-blog-filter]')];
    const cards = [...library.querySelectorAll('[data-blog-card]')];
    const empty = library.querySelector('[data-blog-empty]');
    filters.forEach((button) => button.addEventListener('click', () => {
      const category = button.dataset.blogFilter;
      filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
      let visible = 0;
      cards.forEach((card) => {
        const show = category === 'All' || card.dataset.category === category;
        card.hidden = !show;
        if (show) visible += 1;
      });
      empty.hidden = visible !== 0;
    }));
  });
</script>

<style>
  .blog-hero { position: relative; isolation: isolate; min-height: 34rem; display: grid; align-items: end; overflow: hidden; color: var(--color-copy-inverse); }
  .blog-hero > img, .blog-hero__shade { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
  .blog-hero__shade { z-index: -1; background: linear-gradient(90deg, rgb(15 31 26 / 90%), rgb(15 31 26 / 50%), rgb(15 31 26 / 15%)); }
  .blog-hero__content { padding-bottom: var(--space-12); }
  .blog-hero .eyebrow { color: var(--color-mint-400); }
  .blog-hero h1 { max-width: 14ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .blog-hero h1 em { display: block; color: var(--color-mint-400); }
  .blog-hero__content > p:last-child { max-width: 46ch; margin-top: var(--space-5); }
  .blog-library { padding-block: var(--space-20); }
  .blog-library__heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-8); }
  .blog-library__heading h2 { max-width: 16ch; margin-top: var(--space-4); font-size: var(--text-2xl); }
  .blog-library__heading > p { color: var(--color-copy-muted); font-size: var(--text-sm); }
  .blog-filters { display: flex; gap: var(--space-2); margin-top: var(--space-10); overflow-x: auto; scrollbar-width: none; }
  .blog-filters::-webkit-scrollbar { display: none; }
  .blog-filters button { flex: none; min-height: 2.75rem; padding: var(--space-2) var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: #fff; font-size: var(--text-sm); }
  .blog-filters button[aria-pressed='true'] { border-color: var(--color-forest-900); color: #fff; background: var(--color-forest-900); }
  .blog-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); margin-top: var(--space-10); }
  .blog-grid article[hidden] { display: none; }
  .blog-grid article { overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: #fff; }
  .blog-grid article > a { display: grid; grid-template-columns: .9fr 1.1fr; height: 100%; }
  .blog-grid img { width: 100%; height: 100%; min-height: 23rem; object-fit: cover; }
  .blog-grid article > a > div { display: flex; flex-direction: column; padding: var(--space-8); }
  .blog-grid h2 { margin-top: var(--space-4); font-size: var(--text-xl); }
  .blog-grid article > a > div > p:not(.eyebrow) { margin-top: var(--space-4); color: var(--color-copy-muted); }
  .blog-grid footer { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: auto; padding-top: var(--space-8); color: var(--color-copy-muted); font-size: var(--text-xs); }
  .blog-empty { margin-top: var(--space-10); padding: var(--space-12); border-radius: var(--radius-xl); background: var(--color-cream-200); text-align: center; }
  @media (max-width: 63.99rem) { .blog-grid { grid-template-columns: 1fr; } }
  @media (max-width: 47.99rem) {
    .blog-hero { min-height: 31rem; }
    .blog-hero__content { padding-bottom: var(--space-8); }
    .blog-hero h1 { font-size: 2.65rem; }
    .blog-library { padding-block: var(--space-12); }
    .blog-library__heading { display: grid; }
    .blog-library__heading h2 { font-size: 2.35rem; }
    .blog-filters { margin-top: var(--space-6); }
    .blog-grid { margin-top: var(--space-6); }
    .blog-grid article > a { grid-template-columns: 1fr; }
    .blog-grid img { min-height: 0; aspect-ratio: 16 / 10; }
    .blog-grid article > a > div { padding: var(--space-6); }
    .blog-grid footer { margin-top: var(--space-6); }
  }
</style>
