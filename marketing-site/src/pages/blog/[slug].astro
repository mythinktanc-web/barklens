---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.sourcesVerified);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = new URL(`/blog/${post.id}/`, 'https://barklens.com').href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.coverImage, 'https://barklens.com').href,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Person',
    name: post.data.author
  },
  publisher: {
    '@type': 'Organization',
    name: 'BarkLens',
    url: 'https://barklens.com'
  }
};
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).format(date);
---

<BaseLayout
  title={post.data.seoTitle || post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  image={post.data.coverImage}
  type="article"
  structuredData={articleSchema}
>
  <article class="article-page">
    <header class="article-hero">
      <img src={post.data.coverImage} alt={post.data.coverAlt} width="1312" height="1600" />
      <div class="article-hero__shade"></div>
      <div class="article-hero__content container">
        <a href={routes.blog}>← Dog health blog</a>
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div>
          <span>{post.data.author}</span>
          <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
        </div>
      </div>
    </header>

    <div class="article-layout container">
      <div class="article-body">
        <Content />
      </div>
      <aside>
        <p class="eyebrow">Article sources</p>
        <ul>
          {post.data.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener">
                <strong>{source.label}</strong>
                <span>{source.note}</span>
              </a>
            </li>
          ))}
        </ul>
        {post.data.veterinaryReviewer && (
          <p class="reviewer">Article reviewed by {post.data.veterinaryReviewer}.</p>
        )}
      </aside>
    </div>

    <section class="article-cta">
      <div class="container">
        <p class="eyebrow">Your dog’s history, in your hands.</p>
        <h2>Keep the record ready for the next question.</h2>
        <ButtonLink href={routes.waitlist} variant="light">Join Waitlist</ButtonLink>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-hero { position: relative; isolation: isolate; min-height: 40rem; display: grid; align-items: end; overflow: hidden; color: var(--color-copy-inverse); }
  .article-hero > img, .article-hero__shade { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 58%; }
  .article-hero__shade { z-index: -1; background: linear-gradient(90deg, rgb(15 31 26 / 94%), rgb(15 31 26 / 62%) 55%, rgb(15 31 26 / 20%)); }
  .article-hero__content { padding-bottom: var(--space-12); }
  .article-hero__content > a, .article-hero .eyebrow { color: var(--color-mint-400); font-size: var(--text-xs); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .article-hero .eyebrow { margin-top: var(--space-8); }
  .article-hero h1 { max-width: 18ch; margin-top: var(--space-4); font-size: var(--text-2xl); }
  .article-hero__content > p:not(.eyebrow) { max-width: 50ch; margin-top: var(--space-5); }
  .article-hero__content > div { display: flex; gap: var(--space-5); margin-top: var(--space-6); color: #d8cfc0; font-size: var(--text-sm); }
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 21rem; gap: var(--space-20); align-items: start; padding-block: var(--space-20); }
  .article-body { max-width: 46rem; }
  .article-body :global(> p:first-child) { color: var(--color-copy); font-family: var(--font-display); font-size: var(--text-lg); }
  .article-body :global(h2) { margin-top: var(--space-16); font-size: var(--text-xl); }
  .article-body :global(p), .article-body :global(ol), .article-body :global(ul) { margin-top: var(--space-5); color: var(--color-copy-muted); }
  .article-body :global(ol), .article-body :global(ul) { display: grid; gap: var(--space-3); padding-left: var(--space-6); }
  .article-body :global(a) { color: var(--color-green-600); text-decoration: underline; text-underline-offset: .2rem; }
  .article-layout aside { position: sticky; top: calc(var(--header-height) + var(--space-6)); padding: var(--space-6); border-radius: var(--radius-xl); background: var(--color-cream-200); }
  .article-layout aside ul { display: grid; gap: var(--space-4); margin-top: var(--space-5); list-style: none; }
  .article-layout aside a { display: grid; gap: var(--space-2); color: var(--color-green-600); }
  .article-layout aside span { color: var(--color-copy-muted); font-size: var(--text-xs); }
  .reviewer { margin-top: var(--space-6); color: var(--color-copy-muted); font-size: var(--text-xs); }
  .article-cta { padding: var(--space-20) 0; background: var(--color-forest-900); color: var(--color-copy-inverse); text-align: center; }
  .article-cta .eyebrow { color: var(--color-mint-400); }
  .article-cta h2 { max-width: 18ch; margin: var(--space-5) auto 0; font-size: var(--text-2xl); }
  .article-cta :global(.button-link) { margin-top: var(--space-8); }
  @media (max-width: 63.99rem) { .article-layout { grid-template-columns: 1fr; gap: var(--space-12); } .article-layout aside { position: static; } }
  @media (max-width: 47.99rem) {
    .article-hero { min-height: 38rem; }
    .article-hero__content { padding-bottom: var(--space-8); }
    .article-hero h1 { font-size: 2.5rem; }
    .article-layout { padding-block: var(--space-12); }
    .article-body :global(h2) { margin-top: var(--space-12); font-size: 1.9rem; }
    .article-cta { padding: var(--space-16) 0; }
    .article-cta h2 { font-size: 2.35rem; }
  }
</style>
