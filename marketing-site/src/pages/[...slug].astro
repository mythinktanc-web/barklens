---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { placeholderPages, routes } from '@config/site';

export function getStaticPaths() {
  return placeholderPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

interface Props {
  page: (typeof placeholderPages)[number];
}

const { page } = Astro.props;
---

<BaseLayout title={`${page.title} | BarkLens`} canonicalPath={`/${page.slug}/`}>
  <section class="placeholder-page">
    <div class="placeholder-page__content">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p>The complete page is coming soon.</p>
      <ButtonLink href={routes.home}>Back to BarkLens</ButtonLink>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-page :global(.button-link) {
    margin-top: var(--space-8);
  }
</style>
