---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';
---

<BaseLayout
  title="How BarkLens Works"
  description="Photograph a lab report, a label, or a meal. BarkLens reads it, dates it, and puts it beside everything else."
  canonicalPath="/how-it-works/"
>
  <section class="how-page">
    <div class="how-page__grid container">
      <div>
        <p class="eyebrow">How it works</p>
        <h1>Your dog’s history belongs in one place.</h1>
        <p class="how-page__lede">
          Photograph a lab report, a label, or a meal. BarkLens reads it, dates it, and puts it
          beside everything else.
        </p>
        <p class="how-page__payoff">No typing. No digging.</p>
        <ButtonLink href={routes.waitlist}>Join Waitlist</ButtonLink>
        <p class="how-page__ownership">
          You choose what to add. BarkLens keeps each record tied to its original source.
          <a href={routes.records}>Your records are yours →</a>
        </p>
      </div>

      <div class="upload-demo">
        <div class="upload-demo__header">
          <span aria-hidden="true">↑</span><strong>Records ready to add</strong><small>3 files</small>
        </div>
        <ul>
          <li><b>PDF</b><span><strong>Lab_Results.pdf</strong><small>Blood chemistry · 3 pages</small></span><time>Jun 26</time></li>
          <li><b>PDF</b><span><strong>Appointment_Summary.pdf</strong><small>Visit notes · 2 pages</small></span><time>Mar 12</time></li>
          <li><b>PDF</b><span><strong>Vaccine_History.pdf</strong><small>Preventive care · 1 page</small></span><time>Nov 12</time></li>
        </ul>
        <div class="upload-demo__panel">
          <h2>Let’s bring Charlie’s records in.</h2>
          <p>✓ Original record kept</p>
          <p>✓ You review what joins the chart</p>
          <p>✓ Every value stays tied to its source</p>
          <button type="button">↑ &nbsp; Choose files</button>
          <small>PDFs, photos, and scans</small>
        </div>
      </div>
    </div>
  </section>

  <section class="how-page__steps">
    <div class="container">
      <p class="eyebrow">Three steps</p>
      <div>
        <article><span>01</span><h2>Add</h2><p>Upload the report or take a photo. Keep the original beside what BarkLens reads.</p></article>
        <article><span>02</span><h2>Ask</h2><p>Ask from the full history rather than starting over with one isolated document.</p></article>
        <article><span>03</span><h2>Understand</h2><p>See the dates, values, records, and reviewed sources behind the answer.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .how-page { padding: var(--space-24) 0; background: var(--color-cream-200); }
  .how-page__grid { display: grid; grid-template-columns: 1fr 27.5rem; gap: var(--space-24); align-items: center; }
  .how-page h1 { max-width: 12ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .how-page__lede { max-width: 42ch; margin-top: var(--space-6); color: var(--color-copy-muted); font-size: var(--text-lg); }
  .how-page__payoff { margin-top: var(--space-5); color: var(--color-green-600); font-family: var(--font-display); font-size: var(--text-xl); }
  .how-page :global(.button-link) { margin-top: var(--space-6); }
  .how-page__ownership { max-width: 46ch; margin-top: var(--space-5); color: var(--color-copy-muted); font-size: var(--text-sm); }
  .how-page__ownership a { color: var(--color-green-600); font-weight: 700; }
  .upload-demo { overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: #fff; box-shadow: var(--shadow-card); }
  .upload-demo__header { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-3); align-items: center; margin: var(--space-4); padding: var(--space-3); border-radius: var(--radius-md); background: #f1f3f2; font-size: var(--text-sm); }
  .upload-demo__header small { color: var(--color-copy-muted); }
  .upload-demo ul { list-style: none; }
  .upload-demo li { display: grid; grid-template-columns: 2.25rem 1fr auto; gap: var(--space-3); align-items: start; padding: var(--space-4); border-top: 1px solid var(--color-border); }
  .upload-demo li > b { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: var(--radius-sm); color: var(--color-green-600); background: #e8f3ef; font-size: .625rem; }
  .upload-demo li span { display: grid; font-size: var(--text-sm); }
  .upload-demo li small, .upload-demo time { color: var(--color-copy-muted); font-size: var(--text-xs); }
  .upload-demo__panel { padding: var(--space-6); background: #161618; color: var(--color-copy-inverse); }
  .upload-demo__panel h2 { max-width: 14ch; font-size: var(--text-lg); }
  .upload-demo__panel p { margin-top: var(--space-3); color: #d8cfc0; font-size: var(--text-sm); }
  .upload-demo__panel button { width: 100%; margin-top: var(--space-6); padding: var(--space-3); border-radius: var(--radius-pill); color: var(--color-forest-900); background: #fff; font-weight: 700; }
  .upload-demo__panel > small { display: block; margin-top: var(--space-3); color: #a89f92; text-align: center; }
  .how-page__steps { padding: var(--space-20) 0; }
  .how-page__steps .container > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); margin-top: var(--space-10); }
  .how-page__steps article { padding: var(--space-8); border-top: 1px solid var(--color-border); }
  .how-page__steps span { color: var(--color-green-600); font-size: var(--text-xs); font-weight: 700; }
  .how-page__steps h2 { margin-top: var(--space-8); font-size: var(--text-xl); }
  .how-page__steps p { margin-top: var(--space-4); color: var(--color-copy-muted); }
  @media (max-width: 63.99rem) { .how-page__grid { grid-template-columns: 1fr; gap: var(--space-12); } .upload-demo { max-width: 36rem; } }
  @media (max-width: 47.99rem) { .how-page { padding: var(--space-16) 0; } .how-page__steps .container > div { grid-template-columns: 1fr; } }
</style>
