---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';

const domains = [
  {
    label: 'Kidney & urinary',
    example: 'Kidney markers, urine findings, and chronic kidney disease staging.',
    sources: 'IRIS, Merck Veterinary Manual, Cornell eClinPath'
  },
  {
    label: 'Liver & biliary',
    example: 'Liver enzymes, bilirubin, bile acids, and related laboratory context.',
    sources: 'Merck Veterinary Manual, Cornell eClinPath, ACVIM'
  },
  {
    label: 'Endocrine',
    example: 'Diabetes, thyroid disease, and Cushing’s disease.',
    sources: 'AAHA, Merck Veterinary Manual, ACVIM'
  },
  {
    label: 'Heart',
    example: 'Cardiac history, respiratory-rate records, and published consensus guidance.',
    sources: 'ACVIM, Merck Veterinary Manual'
  },
  {
    label: 'Medications',
    example: 'Approved labels, precautions, and laboratory language tied to a prescription.',
    sources: 'FDA-approved drug labeling, manufacturer prescribing information'
  },
  {
    label: 'Nutrition & digestion',
    example: 'Pancreatitis, diet history, stool records, and digestive-health context.',
    sources: 'Merck Veterinary Manual, AAHA, peer-reviewed veterinary literature'
  }
];
---

<BaseLayout
  title="Where BarkLens answers come from | Veterinary sources"
  description="See how BarkLens connects your dog’s records to published veterinary sources and keeps each source available for review."
  canonicalPath="/where-the-answers-come-from/"
>
  <section class="sources-hero">
    <div class="sources-hero__grid container">
      <div>
        <p class="eyebrow">Sources</p>
        <h1>Where the answers come from.</h1>
      </div>
      <div class="sources-hero__copy">
        <p>
          BarkLens draws from two places: your dog’s own records and published veterinary
          sources. Every answer keeps those origins visible.
        </p>
        <p class="sources-boundary">BarkLens doesn’t diagnose. Your vet does.</p>
      </div>
    </div>
  </section>

  <section class="source-system container">
    <div class="source-system__intro">
      <p class="eyebrow">The library</p>
      <h2>The record leads. The science provides context.</h2>
    </div>
    <div class="source-system__cards">
      <article>
        <span>01</span>
        <h3>Published</h3>
        <p>
          General health information comes from veterinary manuals, practice guidelines,
          consensus statements, peer-reviewed literature, and approved drug labeling.
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Traceable</h3>
        <p>
          The source stays attached, so you can see the publication behind the information
          and return to the original.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Source-reviewed</h3>
        <p>Every source reviewed by a licensed veterinarian.</p>
      </article>
    </div>
  </section>

  <section class="source-list">
    <div class="source-list__grid container">
      <div>
        <p class="eyebrow">The sources</p>
        <h2>Recognized veterinary institutions and original publications.</h2>
        <p>
          The library includes sources such as the Merck Veterinary Manual, Cornell
          University’s eClinPath and Animal Health Diagnostic Center, AAHA practice
          guidelines, ACVIM consensus statements, ACVS, IRIS, and FDA-approved drug
          labeling.
        </p>
      </div>
      <ul aria-label="Veterinary source institutions">
        <li><span>Merck</span><strong>Veterinary Manual</strong></li>
        <li><span>Cornell</span><strong>eClinPath · AHDC</strong></li>
        <li><span>AAHA</span><strong>Practice guidelines</strong></li>
        <li><span>ACVIM</span><strong>Consensus statements</strong></li>
        <li><span>ACVS</span><strong>Surgical information</strong></li>
        <li><span>IRIS</span><strong>Kidney guidelines</strong></li>
        <li><span>FDA</span><strong>Approved drug labeling</strong></li>
      </ul>
    </div>
  </section>

  <section class="domain-library container">
    <div class="domain-library__heading">
      <p class="eyebrow">The library, by domain</p>
      <h2>Open a section to see what sits behind it.</h2>
    </div>
    <div class="domain-library__accordions">
      {domains.map((domain, index) => (
        <article data-source-domain>
          <h3>
            <button
              type="button"
              aria-expanded="false"
              aria-controls={`source-domain-${index}`}
            >
              <span>{domain.label}</span><i aria-hidden="true">+</i>
            </button>
          </h3>
          <div id={`source-domain-${index}`} hidden>
            <p>{domain.example}</p>
            <small><strong>Source set:</strong> {domain.sources}</small>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sources-cta">
    <div class="container">
      <p class="eyebrow">Your dog’s history</p>
      <h2>The internet knows dogs. BarkLens knows yours.</h2>
      <p>
        Keep the records, values, dates, and published context together, ready for the next
        question.
      </p>
      <ButtonLink href={routes.waitlist}>Join Waitlist</ButtonLink>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-source-domain] button').forEach((button) => {
    button.addEventListener('click', () => {
      const panel = document.getElementById(button.getAttribute('aria-controls'));
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      button.querySelector('i').textContent = open ? '+' : '−';
    });
  });
</script>

<style>
  .sources-hero { padding: var(--space-24) 0; background: var(--color-forest-900); color: var(--color-copy-inverse); }
  .sources-hero__grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: var(--space-20); align-items: end; }
  .sources-hero .eyebrow { color: var(--color-mint-400); }
  .sources-hero h1 { max-width: 11ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .sources-hero__copy > p:first-child { max-width: 41ch; color: #d8cfc0; font-size: var(--text-lg); }
  .sources-boundary { margin-top: var(--space-6); color: #a9bdb6; font-size: var(--text-sm); font-style: italic; }
  .source-system { padding-block: var(--space-20); }
  .source-system__intro { display: grid; grid-template-columns: .65fr 1.35fr; gap: var(--space-12); align-items: start; }
  .source-system__intro h2 { max-width: 15ch; font-size: var(--text-2xl); }
  .source-system__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); margin-top: var(--space-12); }
  .source-system__cards article { min-height: 18rem; padding: var(--space-8); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: #fff; }
  .source-system__cards span { color: var(--color-green-600); font-size: var(--text-xs); font-weight: 800; letter-spacing: .12em; }
  .source-system__cards h3 { margin-top: var(--space-12); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; }
  .source-system__cards p { margin-top: var(--space-4); color: var(--color-copy-muted); }
  .source-list { padding-block: var(--space-20); background: var(--color-cream-200); }
  .source-list__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--space-20); align-items: start; }
  .source-list h2 { max-width: 15ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .source-list__grid > div > p:last-child { max-width: 50ch; margin-top: var(--space-6); color: var(--color-copy-muted); }
  .source-list ul { list-style: none; border-top: 1px solid var(--color-border); }
  .source-list li { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-6); padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
  .source-list li span { color: var(--color-green-600); font-size: var(--text-sm); font-weight: 800; text-transform: uppercase; }
  .source-list li strong { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  .domain-library { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-20); padding-block: var(--space-20); }
  .domain-library__heading h2 { max-width: 13ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .domain-library__accordions { border-top: 1px solid var(--color-border); }
  .domain-library__accordions article { border-bottom: 1px solid var(--color-border); }
  .domain-library__accordions h3 { font-size: inherit; }
  .domain-library__accordions button { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: var(--space-6) 0; text-align: left; }
  .domain-library__accordions button span { font-family: var(--font-display); font-size: var(--text-xl); }
  .domain-library__accordions button i { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; color: var(--color-green-600); font-style: normal; }
  .domain-library__accordions article > div { padding: 0 var(--space-12) var(--space-6) 0; }
  .domain-library__accordions article > div p { color: var(--color-copy-muted); }
  .domain-library__accordions article > div small { display: block; margin-top: var(--space-3); color: var(--color-copy-muted); }
  .sources-cta { padding-block: var(--space-24); background: var(--color-green-600); color: var(--color-copy-inverse); text-align: center; }
  .sources-cta .eyebrow { color: var(--color-mint-400); }
  .sources-cta h2 { max-width: 18ch; margin: var(--space-5) auto 0; font-size: var(--text-2xl); }
  .sources-cta p:not(.eyebrow) { max-width: 46ch; margin: var(--space-5) auto 0; color: #d8cfc0; }
  .sources-cta :global(.button-link) { margin-top: var(--space-8); color: var(--color-forest-900); background: var(--color-mint-500); }
  @media (max-width: 63.99rem) {
    .sources-hero__grid, .source-list__grid, .domain-library { grid-template-columns: 1fr; gap: var(--space-12); }
    .source-system__cards { grid-template-columns: 1fr; }
    .source-system__cards article { min-height: auto; }
  }
  @media (max-width: 47.99rem) {
    .sources-hero { padding: var(--space-16) 0; }
    .source-system__intro { grid-template-columns: 1fr; }
  }
</style>
