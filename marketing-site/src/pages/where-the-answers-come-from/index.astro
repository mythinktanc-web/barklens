---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';

const comparisonRows = [
  {
    label: 'Draws on',
    barklens: 'Your dog’s own dated records',
    general: 'Whatever it was trained on',
    why: 'Your dog isn’t the average dog'
  },
  {
    label: 'Sources',
    barklens: 'Veterinary textbooks, peer-reviewed journals, university references, clinical guidelines',
    general: 'A forum post and a textbook count the same',
    why: 'No message boards. Ever.'
  },
  {
    label: 'Every source is',
    barklens: 'Reviewed by a licensed veterinarian',
    general: 'Not reviewed by anyone',
    why: 'A vet decided what counts'
  },
  {
    label: 'Proof',
    barklens: 'Tap any claim, read the source',
    general: 'Take its word for it',
    why: 'You don’t have to trust us'
  }
] as const;
---

<BaseLayout
  title="Where BarkLens answers come from | Veterinary sources"
  description="See how BarkLens connects your dog’s records to published veterinary sources and keeps each source available for review."
  canonicalPath="/where-the-answers-come-from/"
  compactFooter
  hideFooterOnMobile
>
  <div class="sources-page">
    <section class="sources-hero sources-wrap">
      <div class="sources-inner">
        <p class="eyebrow">Not all answers are built the same.</p>
        <h1>The BarkLens <em>Standard.</em></h1>
        <p class="sources-hero__desktop-copy">
          Everything BarkLens tells you about your dog comes from one of two places: your dog’s
          own records, or a published veterinary source that a licensed veterinarian approved.
          Not the open internet, and not whatever a model happens to remember.
        </p>
        <p class="sources-hero__mobile-copy">
          Everything BarkLens tells you comes from your dog’s own records, or a veterinary
          source a licensed vet approved.
        </p>
      </div>
    </section>

    <section class="sources-evidence sources-wrap">
      <div class="sources-inner">
        <h2>Why we’re this strict</h2>
        <div class="sources-evidence__desktop-copy">
          <p>
            In a study of 636 citations from AI-generated papers, 55% of the works cited by
            GPT-3.5 were fabricated
            (<a href="https://www.nature.com/articles/s41598-023-41032-5" target="_blank" rel="noopener">Scientific Reports</a>).
            In another, eight AI search tools were asked to name the source of a direct quote
            across 1,600 queries and got it wrong more than 60% of the time
            (<a href="https://www.cjr.org/tow_center/we-compared-eight-ai-search-engines-theyre-all-bad-at-citing-news.php" target="_blank" rel="noopener">Columbia Journalism Review</a>).
          </p>
        </div>
        <div class="sources-evidence__mobile-copy">
          <p>
            In one study, 55% of the works cited by GPT-3.5 were fabricated
            (<a href="https://www.nature.com/articles/s41598-023-41032-5" target="_blank" rel="noopener">Scientific Reports</a>).
          </p>
        </div>
      </div>
    </section>

    <section class="sources-comparison sources-wrap" aria-label="BarkLens and general AI comparison">
      <div class="sources-inner">
        <div class="comparison-desktop">
          <div class="comparison-desktop__header" aria-hidden="true">
            <span></span><span>BarkLens</span><span>General AI</span><span>Why it matters</span>
          </div>
          {comparisonRows.map((row) => (
            <div class="comparison-desktop__row">
              <span>{row.label}</span>
              <span>{row.barklens}</span>
              <span>{row.general}</span>
              <span>{row.why}</span>
            </div>
          ))}
        </div>

        <div class="comparison-mobile">
          <div class="comparison-mobile__header">
            <span>BarkLens</span><span>General AI</span>
          </div>
          {comparisonRows.map((row) => (
            <div class="comparison-mobile__row">
              <span class="comparison-mobile__label">{row.label}</span>
              <div><span>{row.barklens}</span><span>{row.general}</span></div>
              <p>→ {row.why}</p>
            </div>
          ))}
        </div>

        <p class="source-names source-names--desktop">
          Merck Veterinary Manual · Cornell University eClinPath · Animal Health Diagnostic
          Center · AAHA practice guidelines · ACVIM consensus statements · ACVS · IRIS ·
          FDA-approved drug labeling
        </p>
        <p class="source-names source-names--mobile">
          Merck · Cornell eClinPath · Animal Health Diagnostic Center · AAHA · ACVIM · ACVS ·
          IRIS · FDA drug labels
        </p>
      </div>
    </section>

    <section class="sources-explainers sources-wrap">
      <div class="sources-inner sources-explainers__grid">
        <article>
          <span class="source-card__number">01</span>
          <h2>What counts as a source</h2>
          <p>Textbooks. Peer-reviewed journals. University veterinary references. The guidelines vets follow. FDA-approved drug labels.</p>
          <p>Nothing from a search engine, a blog, or a forum.</p>
        </article>
        <article>
          <span class="source-card__number">02</span>
          <h2>Who checks them</h2>
          <p>A licensed veterinarian reviews every source before it’s used.</p>
          <p class="desktop-only">They’re not reviewing your dog’s results. Those belong to your own vet, who has examined your dog.</p>
          <p class="mobile-only">Not your dog’s results. Those belong to your own vet.</p>
        </article>
        <article>
          <span class="source-card__number">03</span>
          <h2>What you can see</h2>
          <p>Every claim shows the passage it came from, word for word, and where it was published.</p>
          <p>If a source is unclear or contradicts itself, the claim doesn’t get used.</p>
        </article>
      </div>
    </section>

    <section class="sources-cta sources-wrap">
      <div class="sources-inner">
        <ButtonLink href={routes.waitlist}>Join</ButtonLink>
        <p class="sources-boundary">BarkLens doesn’t diagnose. Your vet does.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sources-page {
    background: #fff;
    color: var(--color-forest-900);
  }

  .sources-wrap {
    padding-inline: var(--space-10);
  }

  .sources-inner {
    width: min(100%, 77.5rem);
    margin-inline: auto;
  }

  .sources-hero {
    padding-top: 5rem;
    padding-bottom: 1rem;
  }

  .sources-hero h1 {
    max-width: 8ch;
    margin-top: 1.125rem;
    font-size: 4rem;
    line-height: 1.04;
  }

  .sources-hero h1 em {
    font-style: normal;
  }

  .sources-hero__desktop-copy {
    max-width: 60ch;
    margin-top: 1.625rem;
    font-size: 1.1875rem;
    line-height: 1.65;
  }

  .sources-hero__mobile-copy,
  .comparison-mobile,
  .source-names--mobile,
  .mobile-only,
  .sources-evidence__mobile-copy {
    display: none;
  }

  .sources-comparison {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }

  .comparison-desktop__header,
  .comparison-desktop__row {
    display: grid;
    grid-template-columns: 9.375rem 1.3fr 1fr 1fr;
  }

  .comparison-desktop__header {
    border-top: 1px solid var(--color-forest-900);
  }

  .comparison-desktop__header span {
    padding: 1rem 1.25rem .875rem;
    color: #5a6660;
    font-size: .8125rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .comparison-desktop__header span:first-child {
    padding-left: 0;
  }

  .comparison-desktop__header span:nth-child(2) {
    color: var(--color-forest-900);
  }

  .comparison-desktop__header span:last-child {
    color: var(--color-green-600);
  }

  .comparison-desktop__row {
    border-top: 1px solid #e4ded2;
  }

  .comparison-desktop__row:last-child {
    border-bottom: 1px solid var(--color-forest-900);
  }

  .comparison-desktop__row > span {
    padding: 1.25rem;
    font-size: 1rem;
    line-height: 1.55;
  }

  .comparison-desktop__row > span:first-child {
    padding-left: 0;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .comparison-desktop__row > span:nth-child(2) {
    background: var(--color-cream-200);
  }

  .comparison-desktop__row > span:nth-child(3) {
    color: #5a6660;
  }

  .comparison-desktop__row > span:last-child {
    color: var(--color-green-600);
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-style: italic;
    line-height: 1.35;
  }

  .source-names {
    margin-top: 1.25rem;
    color: #5a6660;
    font-size: .875rem;
    line-height: 1.6;
  }

  .sources-explainers {
    padding-block: 2rem 4rem;
  }

  .sources-explainers__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .sources-explainers article {
    min-width: 0;
    min-height: 15rem;
    padding: 2rem;
    border-radius: .875rem;
    background: var(--color-cream-200);
  }

  .source-card__number {
    color: var(--color-green-600);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
  }

  .sources-explainers h2 {
    margin-top: 1.5rem;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .sources-explainers p {
    margin-top: .75rem;
    font-size: .875rem;
    line-height: 1.55;
  }

  .sources-standards {
    padding-bottom: 4rem;
  }

  .sources-standards__panel {
    padding: 2.5rem 2rem;
    border-radius: 1.25rem;
    background: var(--color-forest-900);
    color: var(--color-cream-300);
  }

  .sources-standards h2,
  .sources-evidence h2 {
    font-size: 2rem;
    line-height: 1.15;
  }

  .sources-standards h2 {
    color: var(--color-cream-200);
  }

  .sources-standards p {
    max-width: 62ch;
    margin-top: .875rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .sources-standards h2 + p {
    margin-top: 1.25rem;
  }

  .sources-evidence {
    padding-top: 1.5rem;
    padding-bottom: 2.75rem;
  }

  .sources-evidence__desktop-copy {
    max-width: 62ch;
    margin-top: 1rem;
  }

  .sources-evidence__desktop-copy p {
    margin-top: .875rem;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .sources-evidence__desktop-copy p:first-child {
    margin-top: 0;
  }

  .sources-evidence a {
    color: var(--color-green-600);
    text-decoration: underline;
    text-underline-offset: .2rem;
  }

  .sources-cta {
    padding-block: 4.5rem 6rem;
    text-align: center;
  }

  .sources-cta :global(.button-link) {
    padding: 1rem 1.75rem;
  }

  .sources-boundary {
    margin-top: 1.5rem;
    color: #5a6660;
    font-family: var(--font-display);
    font-size: .9375rem;
    font-style: italic;
    line-height: 1.4;
    text-align: center !important;
  }

  @media (max-width: 63.99rem) and (min-width: 48rem) {
    .comparison-desktop__header,
    .comparison-desktop__row {
      grid-template-columns: 7rem 1.2fr 1fr 1fr;
    }

    .sources-explainers__grid {
      gap: var(--space-8);
    }
  }

  @media (max-width: 47.99rem) {
    .sources-page {
      display: flex;
      flex-direction: column;
      background: var(--color-forest-900);
      color: var(--color-cream-300);
    }

    .sources-hero { order: 1; }
    .sources-evidence { order: 2; }
    .sources-comparison { order: 3; }
    .sources-explainers { order: 4; }
    .sources-cta { order: 5; }

    .sources-wrap {
      padding-inline: var(--space-6);
    }

    .sources-hero {
      padding-top: 2.5rem;
      padding-bottom: 0;
    }

    .sources-hero .eyebrow {
      color: var(--color-mint-500);
    }

    .sources-hero h1 {
      max-width: none;
      margin-top: .875rem;
      color: var(--color-cream-200);
      font-size: var(--type-section-size);
      line-height: var(--type-section-line);
    }

    .sources-hero h1 em {
      color: var(--color-mint-500);
      font-style: italic;
    }

    .sources-hero__desktop-copy,
    .comparison-desktop,
    .source-names--desktop,
    .desktop-only {
      display: none;
    }

    .sources-hero__mobile-copy,
    .comparison-mobile,
    .source-names--mobile,
    .mobile-only {
      display: block;
    }

    .sources-evidence__desktop-copy {
      display: block;
    }

    .sources-evidence__mobile-copy {
      display: none;
    }

    .sources-hero__mobile-copy {
      max-width: 34ch;
      margin-top: 1.125rem;
      color: rgb(237 227 212 / 95%);
    }

    .sources-comparison {
      padding-top: 2rem;
      padding-bottom: 0;
    }

    .comparison-mobile {
      display: flex;
      flex-direction: column;
    }

    .comparison-mobile__header {
      position: static;
      display: grid;
      grid-template-columns: 55fr 45fr;
      gap: 1rem;
      padding: .75rem 0;
      border-bottom: 1px solid rgb(237 227 212 / 20%);
      background: var(--color-forest-900);
    }

    .comparison-mobile__header span {
      color: var(--color-cream-300);
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .comparison-mobile__header span:first-child {
      color: var(--color-mint-500);
    }

    .comparison-mobile__row {
      display: flex;
      flex-direction: column;
      gap: .625rem;
      padding: 1.125rem 0;
      border-bottom: 1px solid rgb(237 227 212 / 10%);
    }

    .comparison-mobile__row:last-child {
      padding-bottom: .25rem;
      border-bottom: 0;
    }

    .comparison-mobile__label {
      color: #c5d0cb;
      font-size: .75rem;
      font-weight: 800;
      letter-spacing: .11em;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .comparison-mobile__row > div {
      display: grid;
      grid-template-columns: 55fr 45fr;
      gap: 1rem;
    }

    .comparison-mobile__row > div span {
      color: var(--color-cream-300);
      font-size: 1rem;
      line-height: 1.5;
    }

    .comparison-mobile__row > div span:last-child {
      text-decoration: line-through;
      text-decoration-color: rgb(237 227 212 / 60%);
      text-decoration-thickness: 2px;
    }

    .comparison-mobile__row > p {
      display: none;
    }

    .source-names {
      margin-top: 1.125rem;
      color: #a89f92;
      font-size: var(--type-caption-size) !important;
      line-height: var(--type-caption-line) !important;
    }

    .sources-explainers {
      padding-block: 2.75rem;
    }

    .sources-explainers__grid {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .sources-explainers article {
      min-height: 0;
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    .source-card__number {
      display: none;
    }

    .sources-explainers h2 {
      padding-top: 1rem;
      border-top: 1px solid rgb(237 227 212 / 30%);
      color: var(--color-cream-200);
      font-size: 1.5rem !important;
      line-height: 1.2 !important;
    }

    .sources-explainers p {
      margin-top: .75rem;
      color: rgb(237 227 212 / 95%);
      font-size: 1rem !important;
      line-height: 1.65 !important;
    }

    .sources-standards {
      padding-bottom: 0;
    }

    .sources-standards__panel {
      padding: 1.625rem 1.375rem;
      border: 1px solid rgb(237 227 212 / 14%);
      background: #182522;
    }

    .sources-standards h2,
    .sources-evidence h2 {
      color: var(--color-cream-200);
      font-size: 1.625rem !important;
      line-height: 1.15 !important;
    }

    .sources-standards p {
      margin-top: .875rem;
      color: var(--color-cream-300);
    }

    .sources-standards h2 + p {
      margin-top: 1rem;
    }

    .sources-evidence {
      padding-top: 2.5rem;
      padding-bottom: 0;
    }

    .sources-evidence__desktop-copy {
      max-width: none;
      margin-top: 1rem;
    }

    .sources-evidence__desktop-copy p {
      color: rgb(237 227 212 / 95%);
      font-size: 1rem;
      line-height: 1.65;
    }

    .sources-evidence a {
      color: var(--color-mint-500);
    }

    .sources-cta {
      padding-top: 2.25rem;
      padding-bottom: 4.5rem;
      text-align: center;
    }

    .sources-cta :global(.button-link) {
      color: #0b0b0c;
      background: var(--color-mint-500);
    }

    .sources-boundary {
      margin-top: 2.25rem;
      color: #a89f92;
      font-size: 1.25rem !important;
      line-height: 1.4 !important;
      text-align: center !important;
    }
  }
</style>
