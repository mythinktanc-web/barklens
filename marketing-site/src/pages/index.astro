---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import HomeSections from '@components/HomeSections.astro';
import { routes } from '@config/site';
---

<BaseLayout
  title="BarkLens | Your dog’s health history, in one place"
  description="BarkLens holds your dog’s health history, connects what you notice at home to what is on the report, and traces every answer to published veterinary sources."
>
  <section class="hero">
    <img
      src="/images/desktop-hero.webp"
      alt="A woman carrying her grey-muzzled dachshund down a forest road"
      width="1774"
      height="887"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>
    <div class="hero__content container">
      <p class="eyebrow">Your dog can’t talk.</p>
      <h1><span>Let their records</span><em>do the talking.</em></h1>
      <p class="hero__lede">
        For years, you remembered everything. Now the chart does. Ask anything and get answers from
        your dog’s history and veterinary science.
      </p>
      <p class="hero__proof">Not just AI. Their history.<br />Real veterinary science. One answer.</p>
      <div class="hero__actions">
        <ButtonLink href={routes.waitlist} variant="light">Join Waitlist</ButtonLink>
        <ButtonLink href={routes.howItWorks} variant="text">See how it works →</ButtonLink>
      </div>
      <p class="hero__microcopy">Built for the owner in the room.</p>
    </div>
  </section>
  <HomeSections />
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--header-height));
    overflow: hidden;
    background: var(--color-forest-900);
    color: var(--color-copy-inverse);
  }

  .hero > img,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
  }

  .hero > img {
    object-fit: cover;
    object-position: center;
  }

  .hero__shade {
    z-index: -1;
    background: linear-gradient(90deg, rgb(8 22 17 / 90%) 0%, rgb(8 22 17 / 68%) 36%, transparent 74%);
  }

  .hero__content {
    display: flex;
    min-height: calc(100dvh - var(--header-height));
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: var(--space-16);
  }

  .hero .eyebrow {
    color: var(--color-mint-400);
  }

  .hero h1 {
    margin-top: var(--space-5);
    font-size: clamp(3.5rem, 5.2vw, 4.75rem);
  }

  .hero h1 span,
  .hero h1 em {
    display: block;
  }

  .hero h1 em {
    color: var(--color-mint-400);
    font-weight: 400;
  }

  .hero__lede {
    max-width: 34ch;
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }

  .hero__proof {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .hero__microcopy {
    margin-top: var(--space-5);
    color: rgb(245 240 232 / 78%);
    font-size: var(--text-xs);
  }

  @media (max-width: 63.99rem) {
    .hero > img {
      object-position: 60% center;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      min-height: calc(100svh - 3.25rem);
    }

    .hero > img {
      object-position: 82% center;
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgb(8 22 17 / 65%) 0%, rgb(8 22 17 / 12%) 38%, rgb(8 22 17 / 94%) 78%, rgb(8 22 17 / 100%) 100%),
        linear-gradient(90deg, rgb(8 22 17 / 24%), transparent);
    }

    .hero__content {
      position: relative;
      min-height: calc(100svh - 3.25rem);
      justify-content: flex-end;
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }

    .hero .eyebrow {
      position: absolute;
      top: var(--space-5);
      left: 0;
    }

    .hero h1 {
      position: absolute;
      top: 3.5rem;
      left: 0;
      max-width: 17ch;
      margin: 0;
      font-size: clamp(2rem, 8.5vw, 2.25rem);
    }

    .hero h1 em {
      color: var(--color-copy-inverse);
    }

    .hero__lede {
      max-width: 33ch;
      margin-top: 0;
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero__actions {
      width: 100%;
      justify-content: center;
      margin-top: var(--space-5);
    }

    .hero__actions :global(.button-link--text) {
      display: none;
    }

    .hero__microcopy {
      width: 100%;
      margin-top: var(--space-4);
      text-align: center;
    }
  }
</style>
