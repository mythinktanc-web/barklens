---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import HomeSections from '@components/HomeSections.astro';
import { routes } from '@config/site';
---

<BaseLayout
  title="BarkLens — Your Dog's Health Records, Explained"
  socialTitle="The internet knows dogs. BarkLens knows yours."
  description="Every dog is different. Ask anything about yours — BarkLens answers from their history and top-tier veterinary sources."
>
  <section class="hero">
    <picture class="hero__picture">
      <source media="(max-width: 47.99rem)" srcset="/images/mobile/hero.webp" />
      <img
        src="/images/desktop-hero.webp"
        alt="An owner carrying her grey-muzzled dachshund down a quiet road"
        width="1774"
        height="887"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__shade"></div>
    <div class="hero__content container">
      <p class="eyebrow">The internet knows dogs.</p>
      <h1>
        <span class="hero__desktop-prefix">The internet knows dogs.</span>{' '}
        <em>BarkLens knows yours.<span class="hero__asterisk">*</span></em>
      </h1>
      <p class="hero__lede hero__lede--desktop">
        Every dog is different. BarkLens is an app that holds your dog’s health history — labs,
        medications, food, visit summaries, your observations. It connects their related records
        and answers questions from published veterinary sources.
      </p>
      <p class="hero__lede hero__lede--mobile">
        Every dog is different. Ask anything about yours - BarkLens answers from their health
        history, your observations, and top-tier veterinary sources.
      </p>
      <p class="hero__proof">
        <span>Always ready for a question. Every answer backed by a source.</span>
      </p>
      <div class="hero__actions">
        <ButtonLink href={routes.waitlist} variant="light">Join the waitlist</ButtonLink>
      </div>
      <div class="hero__difference">
        <span>How we differ from general AI</span>
        <a href={routes.sources}>The BarkLens Standard →</a>
      </div>
      <p class="hero__boundary">BarkLens doesn’t diagnose. Your vet does.</p>
    </div>
  </section>
  <HomeSections />
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--header-height));
    overflow: hidden;
    background: var(--color-forest-900);
    color: var(--color-copy-inverse);
  }

  .hero > picture,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
  }

  .hero__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__shade {
    z-index: -1;
    background: linear-gradient(90deg, rgb(8 22 17 / 90%) 0%, rgb(8 22 17 / 68%) 36%, transparent 74%);
  }

  .hero__content {
    display: flex;
    min-height: calc(100dvh - var(--header-height));
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: var(--space-16);
  }

  .hero .eyebrow {
    color: var(--color-mint-400);
    font-size: clamp(1rem, 1.2vw, 1.125rem) !important;
    font-weight: 800 !important;
  }

  .hero h1 {
    margin-top: var(--space-5);
    font-size: clamp(3.5rem, 5.2vw, 4.75rem);
  }

  .hero h1 span,
  .hero h1 em {
    display: block;
  }

  .hero h1 em {
    color: var(--color-copy-inverse);
    font-weight: 400;
  }

  .hero h1 .hero__asterisk {
    display: inline;
    margin-left: .08em;
    font-size: .55em;
    vertical-align: super;
  }

  .hero__lede {
    max-width: 34ch;
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }

  .hero__lede--mobile {
    display: none;
  }

  .hero__proof {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.5;
  }

  .hero__proof span,
  .hero__proof a {
    display: block;
  }

  .hero__proof a {
    margin-top: var(--space-3);
    color: var(--color-mint-400);
    text-decoration: underline;
    text-underline-offset: .2rem;
  }

  .hero__difference {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .hero__difference span {
    color: rgb(245 240 232 / 78%);
  }

  .hero__difference a {
    color: var(--color-mint-400);
    font-weight: 700;
    text-decoration: none;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .hero__boundary {
    margin-top: var(--space-5);
    color: rgb(245 240 232 / 78%);
    font-size: var(--text-xs);
  }

  @media (min-width: 64rem) {
    .hero__content {
      width: min(calc(100% - 2 * var(--space-10)), 56rem);
      transform: translateY(1rem);
    }

    .hero .eyebrow {
      display: none;
    }

    .hero h1 {
      max-width: 12.5ch;
      margin-top: 0;
      font-size: clamp(3.25rem, 4vw, 3.75rem);
      line-height: 1.04;
    }

    .hero h1 em {
      color: var(--color-mint-400);
    }

    .hero__lede {
      max-width: 36ch;
      font-size: 1.0625rem;
      line-height: 1.6;
    }

    .hero__proof {
      font-size: .9375rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 63.99rem) {
    .hero__desktop-prefix {
      display: none !important;
    }

    .hero__lede--desktop {
      display: none;
    }

    .hero__lede--mobile {
      display: block;
    }

    .hero__picture img {
      object-position: 60% center;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      min-height: calc(100svh - 3.25rem);
    }

    .hero__picture img {
      object-position: 60% 0%;
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgb(8 22 17 / 65%) 0%, rgb(8 22 17 / 12%) 38%, rgb(8 22 17 / 94%) 78%, rgb(8 22 17 / 100%) 100%),
        linear-gradient(90deg, rgb(8 22 17 / 24%), transparent);
    }

    .hero__content {
      position: relative;
      min-height: calc(100svh - 3.25rem);
      justify-content: flex-end;
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }

    .hero .eyebrow {
      position: absolute;
      top: var(--space-5);
      left: 0;
    }

    .hero h1 {
      position: absolute;
      top: 3.5rem;
      left: 0;
      max-width: 100%;
      margin: 0;
      font-size: clamp(1.85rem, 7.8vw, 2.05rem);
    }

    .hero h1 em {
      color: var(--color-copy-inverse);
    }

    .hero__lede {
      max-width: 33ch;
      margin-top: 0;
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero__actions {
      width: 100%;
      justify-content: center;
      margin-top: var(--space-5);
    }

    .hero__actions :global(.button-link--text) {
      display: none;
    }

    .hero__boundary {
      width: 100%;
      margin-top: var(--space-4);
      text-align: center;
    }
  }
</style>
