---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';

const tasks = [
  ['Breakfast', 'Half cup · omega-3 chew alongside', 'You · 7:42am'],
  ['Rimadyl', 'Morning dose, with food', 'You · 8:05am'],
  ['Light walk', 'Around the block, easy pace', 'Mark · 9:20am'],
  ['Lunch', 'Quarter cup', 'Tap when done'],
  ['Light walk', 'Second of the day', 'Tap when done'],
  ['Dinner', 'Half cup', 'Tap when done']
];
---

<BaseLayout
  title="Care Team — Share Your Dog's Chart"
  description="Add your partner, sitter, or dog walker at no cost. They see today’s medications and your emergency contacts."
  canonicalPath="/care-team/"
>
  <section class="care-page">
    <div class="care-page__grid container">
      <div>
        <p class="eyebrow">Care team</p>
        <h1>Everyone who helps, on the same page.</h1>
        <p>Add your partner, sitter, or dog walker at no cost. They see today’s medications and your emergency contacts.</p>
        <p>Invite a partner, family member, or sitter. Each event they confirm is signed and timed.</p>
        <blockquote>The “did you already give it?” text, retired.</blockquote>
        <p>A co-owner seat is included in every plan. Helper seats are free.</p>
        <ButtonLink href={routes.plans}>See plans</ButtonLink>
      </div>
      <div class="care-board" data-care-board>
        <header><div><p>A day in the app</p><strong>Charlie</strong></div><span data-care-count>3 of 6</span></header>
        <div>
          {tasks.map(([title, sub, by], index) => (
            <button type="button" data-care-task data-complete={index < 3 ? 'true' : 'false'}>
              <span><strong>{title}</strong><small>{sub}</small></span>
              <em>{by}</em>
            </button>
          ))}
        </div>
        <p>Tap to confirm it. Your name and the time go on the record.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-care-board]').forEach((board) => {
    const tasks = [...board.querySelectorAll('[data-care-task]')];
    const count = board.querySelector('[data-care-count]');
    const update = () => {
      const done = tasks.filter((task) => task.dataset.complete === 'true').length;
      if (count) count.textContent = `${done} of ${tasks.length}`;
    };
    tasks.forEach((task) => task.addEventListener('click', () => {
      const done = task.dataset.complete === 'true';
      task.dataset.complete = String(!done);
      const status = task.querySelector('em');
      if (status) status.textContent = done ? 'Tap when done' : 'You · just now';
      update();
    }));
  });
</script>

<style>
  .care-page { min-height: calc(100dvh - var(--header-height)); padding: var(--space-24) 0; background: var(--color-cream-200); }
  .care-page__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--space-20); align-items: center; }
  .care-page h1 { max-width: 13ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .care-page__grid > div:first-child > p:not(.eyebrow) { max-width: 42ch; margin-top: var(--space-6); color: var(--color-copy-muted); }
  .care-page blockquote { max-width: 18ch; margin-top: var(--space-8); font-family: var(--font-display); font-size: var(--text-xl); }
  .care-page :global(.button-link) { margin-top: var(--space-8); }
  .care-board { overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: #fff; box-shadow: var(--shadow-card); }
  .care-board header { display: flex; align-items: center; justify-content: space-between; padding: var(--space-6); background: var(--color-forest-900); color: #fff; }
  .care-board header p { color: var(--color-mint-400); font-size: var(--text-xs); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .care-board header strong { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  .care-board header span { color: #a9bdb6; font-size: var(--text-sm); }
  .care-board > div { display: grid; }
  .care-board button { display: flex; min-height: 4.5rem; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) var(--space-6); border-bottom: 1px solid var(--color-border); background: #fff; text-align: left; }
  .care-board button[data-complete='true'] { background: #f0f7f4; }
  .care-board button span { display: grid; }
  .care-board button small, .care-board button em { color: var(--color-copy-muted); font-size: var(--text-xs); font-style: normal; }
  .care-board > p { padding: var(--space-4) var(--space-6); color: var(--color-copy-muted); font-size: var(--text-xs); }
  @media (max-width: 63.99rem) { .care-page__grid { grid-template-columns: 1fr; } }
</style>
