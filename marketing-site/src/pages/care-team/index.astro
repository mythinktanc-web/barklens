---
import BaseLayout from '@layouts/BaseLayout.astro';
import BackToWhy from '@components/BackToWhy.astro';

const careTasks = [
  ['Prednisone 5 mg', 'Morning · with food', 'Sarah', '7:42 AM'],
  ['Breakfast', '1 cup Hill’s k/d', 'Mark', '7:45 AM'],
  ['Midday walk', '20 min · easy pace', 'Sarah', '12:10 PM'],
  ['Glucosamine chew', 'Evening · 2 chews', '', ''],
  ['Dinner', '1 cup Hill’s k/d', '', '']
] as const;
---

<BaseLayout
  title="Care Circle — Share Your Dog's Chart"
  description="Invite the people who help with your dog. Give each person their own login and control how much of the chart they can see."
  canonicalPath="/care-team/"
>
  <article class="care-page">
    <section class="care-hero">
      <div class="care-hero__grid container">
        <div class="care-hero__copy">
          <BackToWhy />
          <p class="eyebrow">Care Circle</p>
          <h1>You’re not the only one <em>who takes care of them</em></h1>
          <p>
            In most households, one person knows the medications. That person is usually you, and
            it’s usually fine — until you’re on a plane and the sitter texts a question you can’t
            answer fast enough.
          </p>
        </div>

        <aside class="care-board" data-care-board aria-label="Charlie’s Care Circle schedule">
          <header>
            <span><strong>Charlie · Today</strong><small>Tue, Jun 14</small></span>
            <b data-care-count>3 of 5 done</b>
          </header>
          <div class="care-board__tasks">
            {careTasks.map(([title, sub, person, time], index) => (
              <button type="button" data-care-task data-complete={index < 3 ? 'true' : 'false'}>
                <i aria-hidden="true">{index < 3 ? '✓' : ''}</i>
                <span><strong>{title}</strong><small>{sub}</small></span>
                <em>{person && <><strong>{person}</strong><small>{time}</small></>}</em>
              </button>
            ))}
          </div>
          <div class="care-board__people">
            <span class="care-avatars" aria-hidden="true"><i>S</i><i>M</i></span>
            <span>Sarah, Mark</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="care-details">
      <div class="care-details__inner container">
        <section class="care-invite">
          <p class="eyebrow">Invite the people who help</p>
          <h2>Each person gets their own login.</h2>
          <p>Each one downloads BarkLens and gets their own login — you decide how much they see.</p>
          <div class="care-roles">
            <article>
              <span>01</span>
              <h3>One co-parent, included.</h3>
              <p>
                Your partner, or whoever shares the decisions. They see everything you see — the
                full chart, every lab, the whole history — and they can add records and log care.
              </p>
            </article>
            <article>
              <span>02</span>
              <h3>Add Guests For Free</h3>
              <p>
                A sitter, a walker, your parents, the kids. They see what they need for today:
                current medications, what’s already been given, feeding, and your emergency
                contacts. Not the medical history.
              </p>
            </article>
          </div>
        </section>

        <div class="care-two-up">
          <section>
            <p class="eyebrow">Everyone can log what they do</p>
            <h2>The “did you already give it?” text, retired.</h2>
            <p>Tap to mark a dose given. Your name and the time go on it.</p>
          </section>
          <section>
            <p class="eyebrow">You stay in control</p>
            <h2>Easy to invite. Easy to undo.</h2>
            <p>
              Add a sitter for the weekend and take them off on Monday. No awkward conversation,
              and nothing stays open after it’s needed.
            </p>
          </section>
        </div>

      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-care-board]').forEach((board) => {
    const tasks = [...board.querySelectorAll('[data-care-task]')];
    const count = board.querySelector('[data-care-count]');
    const update = () => {
      const done = tasks.filter((task) => task.dataset.complete === 'true').length;
      if (count) count.textContent = `${done} of ${tasks.length} done`;
    };
    tasks.forEach((task) => task.addEventListener('click', () => {
      const done = task.dataset.complete === 'true';
      task.dataset.complete = String(!done);
      const check = task.querySelector('i');
      if (check) check.textContent = done ? '' : '✓';
      update();
    }));
  });
</script>

<style>
  .care-page {
    color: var(--color-forest-900);
    background: #fff;
  }

  .care-hero {
    padding: .75rem 0 5rem;
  }

  .care-hero__grid,
  .care-details__inner {
    width: min(calc(100% - 2 * var(--space-10)), 68.75rem);
  }

  .care-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26.25rem;
    gap: 6rem;
    align-items: center;
  }

  .care-hero__copy h1 {
    max-width: 16ch;
    margin-top: 1.125rem;
    font-size: 4rem;
    line-height: 1.04;
  }

  .care-hero__copy h1 em {
    color: var(--color-green-600);
  }

  .care-hero__copy > p:last-child {
    max-width: 39rem;
    margin-top: 1.75rem;
    color: #273a33;
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .care-details {
    padding: 6rem 0;
    background: var(--color-cream-200);
  }

  .care-details h2 {
    max-width: 20ch;
    margin-top: 1rem;
    font-size: 2.75rem;
    line-height: 1.08;
  }

  .care-invite > p:last-of-type,
  .care-two-up section > p:last-child {
    max-width: 54ch;
    margin-top: 1.25rem;
    color: #52615b;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .care-roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .care-roles article {
    min-height: 19rem;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: #fff;
  }

  .care-roles article > span {
    color: var(--color-green-600);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .care-roles h3 {
    max-width: 18ch;
    margin-top: 3.5rem;
    font-size: 1.8rem;
    line-height: 1.12;
  }

  .care-roles article:first-child h3 {
    max-width: none;
    white-space: nowrap;
  }

  .care-roles p {
    margin-top: 1rem;
    color: #52615b;
    line-height: 1.65;
  }

  .care-two-up {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 6rem;
    padding-top: 4rem;
    border-top: 1px solid var(--color-border);
  }

  .care-two-up h2 {
    font-size: 2.25rem;
  }

  .care-board {
    position: sticky;
    top: calc(var(--header-height) + 1.75rem);
    overflow: hidden;
    border: 1px solid rgb(237 227 212 / 14%);
    border-radius: 1.375rem;
    color: var(--color-cream-300);
    background: #182522;
    box-shadow: 0 1.75rem 3.75rem rgb(0 0 0 / 55%), 0 .375rem 1rem rgb(0 0 0 / 35%);
  }

  .care-board header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: 1rem 1.125rem .875rem;
    border-bottom: 1px solid rgb(237 227 212 / 12%);
    background: rgb(237 227 212 / 5%);
  }

  .care-board header > span {
    display: flex;
    flex-direction: column;
    gap: .125rem;
  }

  .care-board header strong {
    color: var(--color-mint-500);
    font-family: var(--font-body);
    font-size: .8125rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .care-board header small {
    color: #a89f92;
    font-size: .75rem;
  }

  .care-board header b {
    padding: .25rem .625rem;
    border-radius: var(--radius-pill);
    color: #0b1512;
    background: var(--color-mint-500);
    font-size: .8125rem;
    white-space: nowrap;
  }

  .care-board__tasks {
    padding: .125rem 1.125rem .375rem;
  }

  .care-board button {
    display: grid;
    width: 100%;
    grid-template-columns: 1.375rem minmax(0, 1fr) auto;
    align-items: center;
    gap: .875rem;
    padding: .8125rem 0;
    border-bottom: 1px solid rgb(237 227 212 / 10%);
    color: var(--color-cream-300);
    background: transparent;
    text-align: left;
  }

  .care-board button:hover {
    background: rgb(237 227 212 / 3%);
  }

  .care-board button > i {
    display: grid;
    width: 1.375rem;
    height: 1.375rem;
    place-items: center;
    border: 1.5px solid rgb(237 227 212 / 34%);
    border-radius: .4375rem;
    color: #0b1512;
    font-size: .75rem;
    font-style: normal;
    font-weight: 800;
  }

  .care-board button[data-complete='true'] > i {
    border-color: var(--color-mint-500);
    background: var(--color-mint-500);
  }

  .care-board button > span {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: .1875rem;
  }

  .care-board button > span strong {
    font-size: .9375rem;
    font-weight: 600;
  }

  .care-board button[data-complete='true'] > span strong {
    color: rgb(237 227 212 / 60%);
    text-decoration: line-through;
    text-decoration-color: rgb(237 227 212 / 35%);
  }

  .care-board button > span small {
    color: #a89f92;
    font-size: .75rem;
    line-height: 1.3;
  }

  .care-board button em {
    display: flex;
    flex-direction: column;
    align-items: end;
    gap: .125rem;
    font-style: normal;
  }

  .care-board button em strong {
    color: var(--color-mint-500);
    font-size: .75rem;
  }

  .care-board button em small {
    color: #a89f92;
    font-size: .6875rem;
    white-space: nowrap;
  }

  .care-board__people {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .75rem 1.125rem 1rem;
    color: #a89f92;
    font-size: .8125rem;
  }

  .care-avatars {
    display: flex;
  }

  .care-avatars i {
    display: grid;
    width: 1.625rem;
    height: 1.625rem;
    place-items: center;
    border: 2px solid #182522;
    border-radius: 50%;
    color: #0b1512;
    background: var(--color-mint-500);
    font-size: .6875rem;
    font-style: normal;
    font-weight: 800;
  }

  .care-avatars i + i {
    margin-left: -.5rem;
    color: var(--color-cream-300);
    background: rgb(237 227 212 / 20%);
  }

  @media (max-width: 63.99rem) {
    .care-hero__grid {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-8);
    }

    .care-hero__copy h1 {
      max-width: none;
      font-size: 2.5rem;
    }

    .care-hero__copy > p:last-child {
      font-size: 1rem;
    }
  }

  @media (max-width: 47.99rem) {
    .care-hero {
      padding: .5rem 0 3.5rem;
      color: var(--color-cream-300);
      background: var(--color-forest-900);
    }

    .care-hero__grid {
      display: flex;
      width: min(calc(100% - 2 * var(--space-6)), 68.75rem);
      flex-direction: column;
      gap: 0;
      padding-top: .5rem;
    }

    .care-hero__copy .eyebrow {
      color: var(--color-mint-500);
    }

    .care-hero__copy h1 {
      max-width: none;
      margin-top: .875rem;
      color: var(--color-cream-200);
      font-size: var(--type-section-size);
      line-height: var(--type-section-line);
    }

    .care-hero__copy h1 em {
      color: var(--color-mint-500);
    }

    .care-hero__copy > p:last-child {
      max-width: 34ch;
      margin-top: 1.25rem;
      color: rgb(237 227 212 / 95%);
      font-size: var(--type-body-size);
      line-height: var(--type-body-line);
    }

    .care-board header strong {
      font-family: var(--font-body) !important;
      font-size: .8125rem !important;
      line-height: 1.2 !important;
    }

    .care-board {
      position: static;
      width: 100%;
      margin-top: 1.875rem;
    }

    .care-details {
      padding: 3.5rem 0;
    }

    .care-details__inner {
      width: min(calc(100% - 2 * var(--space-5)), 68.75rem);
    }

    .care-details h2 {
      max-width: none;
      font-size: var(--type-subhead-size);
      line-height: var(--type-subhead-line);
    }

    .care-invite > p:last-of-type,
    .care-two-up section > p:last-child {
      font-size: var(--type-body-size);
      line-height: var(--type-body-line);
    }

    .care-roles,
    .care-two-up {
      grid-template-columns: 1fr;
    }

    .care-roles article {
      min-height: 0;
      padding: 1.5rem;
    }

    .care-roles h3 {
      margin-top: 2rem;
      font-size: var(--type-card-size);
      line-height: var(--type-card-line);
    }

    .care-two-up {
      gap: 3rem;
      margin-top: 4rem;
      padding-top: 3rem;
    }

    .care-two-up h2 {
      font-size: var(--type-subhead-size);
    }

  }
</style>
