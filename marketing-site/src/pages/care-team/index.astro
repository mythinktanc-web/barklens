---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import BackToWhy from '@components/BackToWhy.astro';
import { routes } from '@config/site';

const careTasks = [
  ['Prednisone 5 mg', 'Morning · with food', 'Sarah', '7:42 AM'],
  ['Breakfast', '1 cup Hill’s k/d', 'Mark', '7:45 AM'],
  ['Midday walk', '20 min · easy pace', 'Sarah', '12:10 PM'],
  ['Glucosamine chew', 'Evening · 2 chews', '', ''],
  ['Dinner', '1 cup Hill’s k/d', '', '']
] as const;
---

<BaseLayout
  title="Care Team — Share Your Dog's Chart"
  description="Add your partner, sitter, walker, or family at no cost. See today’s medications, completed care, and emergency contacts."
  canonicalPath="/care-team/"
  compactFooter
  hideFooterOnMobile
>
  <section class="care-page">
    <div class="care-page__content container">
      <div class="care-page__left">
        <div class="care-page__heading">
          <BackToWhy />
          <p class="eyebrow">03 · Care team</p>
          <h1>You’re not the only one <em>who takes care of them</em></h1>
        </div>
        <div class="care-page__copy">
          <p>Add your partner, a sitter, a walker, or family at no cost. They see today’s medications, what’s been given, and your emergency contacts.</p>
          <p>Every dose logs who gave it and when. Nobody has to guess.</p>
          <ButtonLink href={routes.waitlist}>Join</ButtonLink>
          <p class="care-boundary">BarkLens doesn’t diagnose. Your vet does.</p>
        </div>
      </div>

      <aside class="care-board" data-care-board aria-label="Charlie’s care team schedule">
        <header>
          <span><strong>Charlie · Today</strong><small>Tue, Jun 14</small></span>
          <b data-care-count>3 of 5 done</b>
        </header>
        <div class="care-board__tasks">
          {careTasks.map(([title, sub, person, time], index) => (
            <button type="button" data-care-task data-complete={index < 3 ? 'true' : 'false'}>
              <i aria-hidden="true">{index < 3 ? '✓' : ''}</i>
              <span><strong>{title}</strong><small>{sub}</small></span>
              <em>{person && <><strong>{person}</strong><small>{time}</small></>}</em>
            </button>
          ))}
        </div>
        <div class="care-board__people">
          <span class="care-avatars" aria-hidden="true"><i>S</i><i>M</i></span>
          <span>Sarah, Mark</span>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-care-board]').forEach((board) => {
    const tasks = [...board.querySelectorAll('[data-care-task]')];
    const count = board.querySelector('[data-care-count]');
    const update = () => {
      const done = tasks.filter((task) => task.dataset.complete === 'true').length;
      if (count) count.textContent = `${done} of ${tasks.length} done`;
    };
    tasks.forEach((task) => task.addEventListener('click', () => {
      const done = task.dataset.complete === 'true';
      task.dataset.complete = String(!done);
      const check = task.querySelector('i');
      if (check) check.textContent = done ? '' : '✓';
      update();
    }));
  });
</script>

<style>
  .care-page {
    min-height: calc(100dvh - var(--header-height));
    padding: 6rem 0;
    color: var(--color-forest-900);
    background: #fff;
  }

  .care-page__content {
    width: min(calc(100% - 2 * var(--space-10)), 68.75rem);
  }

  .care-page__heading {
    padding-bottom: 1.5rem;
  }

  .care-page__heading h1 {
    max-width: 16ch;
    margin-top: 1.125rem;
    font-size: 4rem;
    line-height: 1.04;
  }

  .care-page__heading h1 em {
    color: var(--color-green-600);
  }

  .care-page__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26.25rem;
    gap: 6rem;
    align-items: center;
  }

  .care-page__copy {
    max-width: 38.75rem;
  }

  .care-page__copy > p:not(.care-boundary) {
    margin-top: 1.25rem;
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .care-page__copy > p:first-child {
    margin-top: 0;
  }

  .care-page__copy :global(.button-link) {
    margin-top: 2.5rem;
    padding: 1rem 1.75rem;
  }

  .care-boundary {
    margin-top: 2.5rem;
    color: #5a6660;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.4;
  }

  .care-board {
    position: sticky;
    top: calc(var(--header-height) + 1.75rem);
    overflow: hidden;
    border: 1px solid rgb(237 227 212 / 14%);
    border-radius: 1.375rem;
    color: var(--color-cream-300);
    background: #182522;
    box-shadow: 0 1.75rem 3.75rem rgb(0 0 0 / 55%), 0 .375rem 1rem rgb(0 0 0 / 35%);
  }

  .care-board header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: 1rem 1.125rem .875rem;
    border-bottom: 1px solid rgb(237 227 212 / 12%);
    background: rgb(237 227 212 / 5%);
  }

  .care-board header > span {
    display: flex;
    flex-direction: column;
    gap: .125rem;
  }

  .care-board header strong {
    color: var(--color-mint-500);
    font-family: var(--font-body);
    font-size: .8125rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .care-board header small {
    color: #a89f92;
    font-size: .75rem;
  }

  .care-board header b {
    padding: .25rem .625rem;
    border-radius: var(--radius-pill);
    color: #0b1512;
    background: var(--color-mint-500);
    font-size: .8125rem;
    white-space: nowrap;
  }

  .care-board__tasks {
    padding: .125rem 1.125rem .375rem;
  }

  .care-board button {
    display: grid;
    width: 100%;
    grid-template-columns: 1.375rem minmax(0, 1fr) auto;
    align-items: center;
    gap: .875rem;
    padding: .8125rem 0;
    border-bottom: 1px solid rgb(237 227 212 / 10%);
    color: var(--color-cream-300);
    background: transparent;
    text-align: left;
  }

  .care-board button:hover {
    background: rgb(237 227 212 / 3%);
  }

  .care-board button > i {
    display: grid;
    width: 1.375rem;
    height: 1.375rem;
    place-items: center;
    border: 1.5px solid rgb(237 227 212 / 34%);
    border-radius: .4375rem;
    color: #0b1512;
    font-size: .75rem;
    font-style: normal;
    font-weight: 800;
  }

  .care-board button[data-complete='true'] > i {
    border-color: var(--color-mint-500);
    background: var(--color-mint-500);
  }

  .care-board button > span {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: .1875rem;
  }

  .care-board button > span strong {
    font-size: .9375rem;
    font-weight: 600;
  }

  .care-board button[data-complete='true'] > span strong {
    color: rgb(237 227 212 / 60%);
    text-decoration: line-through;
    text-decoration-color: rgb(237 227 212 / 35%);
  }

  .care-board button > span small {
    color: #a89f92;
    font-size: .75rem;
    line-height: 1.3;
  }

  .care-board button em {
    display: flex;
    flex-direction: column;
    align-items: end;
    gap: .125rem;
    font-style: normal;
  }

  .care-board button em strong {
    color: var(--color-mint-500);
    font-size: .75rem;
  }

  .care-board button em small {
    color: #a89f92;
    font-size: .6875rem;
    white-space: nowrap;
  }

  .care-board__people {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .75rem 1.125rem 1rem;
    color: #a89f92;
    font-size: .8125rem;
  }

  .care-avatars {
    display: flex;
  }

  .care-avatars i {
    display: grid;
    width: 1.625rem;
    height: 1.625rem;
    place-items: center;
    border: 2px solid #182522;
    border-radius: 50%;
    color: #0b1512;
    background: var(--color-mint-500);
    font-size: .6875rem;
    font-style: normal;
    font-weight: 800;
  }

  .care-avatars i + i {
    margin-left: -.5rem;
    color: var(--color-cream-300);
    background: rgb(237 227 212 / 20%);
  }

  @media (max-width: 63.99rem) {
    .care-page__content {
      grid-template-columns: minmax(0, 1fr) 23rem;
      gap: var(--space-10);
    }
  }

  @media (max-width: 47.99rem) {
    .care-page {
      min-height: 100dvh;
      padding: 2.5rem 0 4.5rem;
      color: var(--color-cream-300);
      background: var(--color-forest-900);
    }

    .care-page__content {
      width: min(calc(100% - 2 * var(--space-6)), 68.75rem);
    }

    .care-page__left {
      display: contents;
    }

    .care-page__heading {
      padding-bottom: 0;
    }

    .care-page__heading .eyebrow {
      color: var(--color-mint-500);
    }

    .care-page__heading h1 {
      max-width: none;
      margin-top: .875rem;
      color: var(--color-cream-200);
      font-size: var(--type-section-size);
      line-height: var(--type-section-line);
    }

    .care-page__heading h1 em {
      color: var(--color-mint-500);
    }

    .care-board header strong {
      font-family: var(--font-body) !important;
      font-size: .8125rem !important;
      line-height: 1.2 !important;
    }

    .care-page__content {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-top: 1.125rem;
    }

    .care-page__copy {
      display: contents;
    }

    .care-page__copy > p:not(.care-boundary) {
      max-width: 34ch;
      margin-top: 0;
      color: rgb(237 227 212 / 95%);
      font-size: var(--type-body-size);
      line-height: var(--type-body-line);
    }

    .care-page__copy > p:nth-child(2) {
      order: 3;
      margin-top: 1.125rem;
    }

    .care-board {
      position: static;
      order: 2;
      width: 100%;
      margin-top: 1.875rem;
    }

    .care-page__copy :global(.button-link) {
      order: 4;
      width: max-content;
      margin: 2.25rem auto 0;
      color: #0b0b0c;
      background: var(--color-mint-500);
    }

    .care-boundary {
      order: 5;
      margin: 1.75rem 0 0;
      color: #a89f92;
      font-size: 1.125rem !important;
      line-height: 1.4 !important;
      text-align: center;
    }
  }
</style>
