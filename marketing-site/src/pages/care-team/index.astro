---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import { routes } from '@config/site';

const tasks = [
  ['Breakfast', 'Half cup · omega-3 chew alongside', 'You · 7:42am'],
  ['Rimadyl', 'Morning dose, with food', 'You · 8:05am'],
  ['Light walk', 'Around the block, easy pace', 'Mark · 9:20am'],
  ['Lunch', 'Quarter cup', 'Tap when done'],
  ['Light walk', 'Second of the day', 'Tap when done'],
  ['Dinner', 'Half cup', 'Tap when done']
];
---

<BaseLayout
  title="Care Team — Share Your Dog's Chart"
  description="Add your partner, sitter, or dog walker at no cost. They see today’s medications and your emergency contacts."
  canonicalPath="/care-team/"
  compactFooter
>
  <section class="care-page">
    <div class="care-page__grid container">
      <div>
        <p class="eyebrow">Care team</p>
        <h1>Everyone who helps, <em>on the same page.</em></h1>
        <p>Invite a partner, the kids, a sitter. Every dose they give is signed and timed.</p>
        <blockquote>The “did you already give it?” text, retired.</blockquote>
        <p>A co-owner seat is included in every plan. Helper seats — a sitter, a walker, a family member — are free forever.</p>
        <ButtonLink href={routes.plans} variant="mint">See plans</ButtonLink>
      </div>
      <div class="care-board" data-care-board>
        <header><p>A day in the app</p><span data-care-count>3 of 6</span></header>
        <div>
          {tasks.map(([title, sub, by], index) => (
            <button type="button" data-care-task data-complete={index < 3 ? 'true' : 'false'}>
              <i aria-hidden="true">{index < 3 ? '✓' : ''}</i>
              <span><strong>{title}</strong><small>{sub}</small></span>
              <em>{by}</em>
            </button>
          ))}
        </div>
        <p>Tap to confirm it. Your name and the time go on the record.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-care-board]').forEach((board) => {
    const tasks = [...board.querySelectorAll('[data-care-task]')];
    const count = board.querySelector('[data-care-count]');
    const update = () => {
      const done = tasks.filter((task) => task.dataset.complete === 'true').length;
      if (count) count.textContent = `${done} of ${tasks.length}`;
    };
    tasks.forEach((task) => task.addEventListener('click', () => {
      const done = task.dataset.complete === 'true';
      task.dataset.complete = String(!done);
      const status = task.querySelector('em');
      const check = task.querySelector('i');
      if (status) status.textContent = done ? 'Tap when done' : 'You · just now';
      if (check) check.textContent = done ? '' : '✓';
      update();
    }));
  });
</script>

<style>
  .care-page { min-height: 40rem; padding: 5.25rem 0 6rem; color: var(--color-copy-inverse); background: var(--color-forest-950); }
  .care-page__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 8rem; align-items: center; width: min(calc(100% - 2 * var(--space-10)), 68.75rem); }
  .care-page h1 { max-width: 10.5ch; margin-top: .75rem; font-size: 4rem; line-height: 1.02; }
  .care-page h1 em { color: var(--color-mint-500); }
  .care-page .eyebrow { color: var(--color-mint-400); }
  .care-page__grid > div:first-child > p:not(.eyebrow) { max-width: 40ch; margin-top: 1.5rem; color: #d8cfc0; font-size: .9375rem; line-height: 1.65; }
  .care-page blockquote { max-width: 17ch; margin-top: 2.25rem; color: var(--color-cream-200); font-family: var(--font-display); font-size: 1.75rem; line-height: 1.18; font-style: italic; }
  .care-page :global(.button-link) { margin-top: 2rem; padding-inline: 1.5rem; }
  .care-board { overflow: hidden; border: 1px solid rgb(255 255 255 / 20%); border-radius: 1.25rem; background: var(--color-forest-800); box-shadow: 0 2rem 5rem rgb(0 0 0 / 24%); }
  .care-board header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-bottom: 1px solid rgb(255 255 255 / 12%); background: #20342d; color: #fff; }
  .care-board header p { color: var(--color-mint-400); font-size: var(--text-xs); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .care-board header span { padding: .2rem .65rem; border-radius: var(--radius-pill); color: var(--color-forest-950); background: var(--color-mint-500); font-size: var(--text-xs); font-weight: 700; }
  .care-board > div { display: grid; }
  .care-board button { display: grid; min-height: 4.2rem; grid-template-columns: 1.25rem 1fr auto; align-items: center; gap: .8rem; padding: .85rem 1.25rem; border-bottom: 1px solid rgb(255 255 255 / 12%); color: var(--color-copy-inverse); background: transparent; text-align: left; }
  .care-board button:hover { background: rgb(255 255 255 / 4%); }
  .care-board button > i { display: grid; width: 1.25rem; height: 1.25rem; place-items: center; border: 1px solid #728079; border-radius: .3rem; color: var(--color-forest-950); font-size: .75rem; font-style: normal; font-weight: 800; }
  .care-board button[data-complete='true'] > i { border-color: var(--color-mint-500); background: var(--color-mint-500); }
  .care-board button span { display: grid; }
  .care-board button small, .care-board button em { color: #a9bdb6; font-size: var(--text-xs); font-style: normal; }
  .care-board button[data-complete='true'] em { color: var(--color-mint-500); }
  .care-board > p { padding: .8rem 1.25rem; color: #a9bdb6; font-size: .75rem; }
  @media (max-width: 63.99rem) {
    .care-page__grid { grid-template-columns: 1fr; gap: var(--space-12); }
    .care-page h1 { font-size: 3.5rem; }
  }
  @media (max-width: 47.99rem) {
    .care-page { padding: var(--space-12) 0 var(--space-16); }
    .care-page__grid { gap: var(--space-10); }
    .care-page h1 { font-size: var(--type-section-size); line-height: var(--type-section-line); }
    .care-page__grid > div:first-child > p:not(.eyebrow) { font-size: var(--type-body-size); line-height: var(--type-body-line); }
    .care-page blockquote { font-size: var(--type-pull-size); line-height: var(--type-pull-line); }
    .care-board button { grid-template-columns: 1.25rem minmax(0, 1fr); gap: var(--space-3); padding: var(--space-4); }
    .care-board button em { grid-column: 2; margin-top: .2rem; }
    .care-board > p { padding-inline: var(--space-4); }
  }
</style>
