---
import BaseLayout from '@layouts/BaseLayout.astro';
import { conditions } from '../../data/home';
---

<BaseLayout
  title="Dog Health Conditions — BarkLens"
  description="Kidney, liver, thyroid, heart, diabetes, Cushing’s, pancreatitis, arthritis — what the numbers mean, and what to ask."
  canonicalPath="/conditions/"
>
  <section class="plain-page">
    <div class="plain-page__layout container">
      <div class="plain-page__intro">
        <p class="eyebrow">After diagnosis</p>
        <h1>A diagnosis is <em>not the whole story.</em></h1>
        <p>
          You don’t have to become a veterinarian overnight. BarkLens helps you understand the
          condition, the labs, the medication, and what to watch between visits — so you can manage
          care from knowledge, not from panic.
        </p>
      </div>
      <div class="plain-page__cards">
        {conditions.map((condition) => (
          <a href={condition.href}>
            <h2>{condition.title}</h2>
            <p>{condition.clue}</p>
            <span>{condition.tag}</span>
            <b>Read →</b>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .plain-page { min-height: calc(100dvh - var(--header-height)); display: grid; align-items: center; padding: var(--space-20) 0; background: var(--color-cream-200); }
  .plain-page__layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: var(--space-20); align-items: start; }
  .plain-page__intro { position: sticky; top: calc(var(--header-height) + var(--space-12)); }
  .plain-page h1 { max-width: 12ch; margin-top: var(--space-6); font-size: var(--text-2xl); }
  .plain-page h1 em { color: var(--color-green-600); }
  .plain-page__intro > p:last-child { max-width: 38ch; margin-top: var(--space-6); color: var(--color-copy-muted); }
  .plain-page__cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .plain-page__cards a { position: relative; display: flex; min-height: 10.5rem; flex-direction: column; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: #fff; }
  .plain-page__cards h2 { font-size: var(--text-lg); }
  .plain-page__cards p { margin-top: var(--space-3); color: var(--color-copy-muted); font-size: var(--text-sm); }
  .plain-page__cards span, .plain-page__cards b { margin-top: auto; padding-top: var(--space-5); color: var(--color-green-600); font-size: var(--text-xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .plain-page__cards b { position: absolute; right: var(--space-5); bottom: var(--space-5); }
  @media (max-width: 63.99rem) { .plain-page__layout { grid-template-columns: 1fr; gap: var(--space-12); } .plain-page__intro { position: static; } }
  @media (max-width: 47.99rem) {
    .plain-page { padding: var(--space-12) 0; }
    .plain-page h1 { font-size: 2.6rem; }
    .plain-page__cards { grid-template-columns: 1fr; }
    .plain-page__cards a { min-height: 9.5rem; padding: var(--space-5); }
  }
</style>
