---
import BaseLayout from '@layouts/BaseLayout.astro';
import { conditionPages } from '../../data/conditions';
---

<BaseLayout
  title="Dog health conditions in plain English | BarkLens"
  description="Plain-English guides for owners organizing records, laboratory results, medications, observations, and veterinary questions."
  canonicalPath="/conditions/"
>
  <header class="conditions-index__hero">
    <div class="container">
      <p class="eyebrow">In plain English</p>
      <h1>The conditions owners ask about most.</h1>
      <p>
        Start with the record in your hand. Keep the laboratory values, medications, observations,
        and questions in one history.
      </p>
    </div>
  </header>
  <section class="conditions-index__grid container">
    {conditionPages.map((page) => (
      <a href={`/conditions/${page.slug}/`}>
        <img src={page.image} alt="" width="2200" height="1400" loading="lazy" />
        <div><h2>{page.title}</h2><p>{page.description}</p><span>Read →</span></div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .conditions-index__hero { padding: var(--space-24) 0 var(--space-16); background: var(--color-cream-200); }
  .conditions-index__hero h1 { max-width: 16ch; margin-top: var(--space-5); font-size: var(--text-2xl); }
  .conditions-index__hero p:last-child { max-width: 48ch; margin-top: var(--space-6); color: var(--color-copy-muted); }
  .conditions-index__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); padding-block: var(--space-20); }
  .conditions-index__grid a { display: grid; grid-template-columns: 12rem 1fr; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: #fff; transition: transform var(--transition), box-shadow var(--transition); }
  .conditions-index__grid a:hover { transform: translateY(-2px); box-shadow: var(--shadow-card); }
  .conditions-index__grid img { width: 100%; height: 100%; object-fit: cover; }
  .conditions-index__grid div { padding: var(--space-6); }
  .conditions-index__grid h2 { font-size: var(--text-lg); }
  .conditions-index__grid p { margin-top: var(--space-3); color: var(--color-copy-muted); font-size: var(--text-sm); }
  .conditions-index__grid span { display: inline-block; margin-top: var(--space-5); color: var(--color-green-600); font-size: var(--text-sm); font-weight: 700; }
  @media (max-width: 63.99rem) { .conditions-index__grid { grid-template-columns: 1fr; } }
  @media (max-width: 35rem) { .conditions-index__grid a { grid-template-columns: 1fr; } .conditions-index__grid img { aspect-ratio: 16 / 8; } }
</style>
