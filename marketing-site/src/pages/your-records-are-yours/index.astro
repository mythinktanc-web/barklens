---
import BaseLayout from '@layouts/BaseLayout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import BackToWhy from '@components/BackToWhy.astro';
import { routes } from '@config/site';
---

<BaseLayout
  title="Share Your Dog’s Health History — BarkLens"
  description="Share one link or QR code so a veterinarian, specialist, sitter, or family member can see your dog’s history."
  canonicalPath="/your-records-are-yours/"
>
  <article class="records-page">
    <section class="records-lead container">
      <header class="records-page__hero">
        <BackToWhy />
        <p class="eyebrow">Share the history</p>
        <h1 class="records-title">
          <span class="records-title__desktop">A pass for the ER, the groomer, the boarder — anyone who needs your dog’s history.</span>
          <span class="records-title__mobile">The next person to see your dog shouldn’t start from zero.</span>
        </h1>
        <p>
          Your dog’s history shouldn’t depend on what you can remember at the front desk. Share the
          records you’ve added to BarkLens with a link or QR code, so a new vet or caregiver has the
          background without you piecing it together from emails, paperwork, and memory.
        </p>
      </header>

      <div class="records-share__copy">
        <p class="eyebrow">The share</p>
        <h2>A pass for the ER, the groomer, the boarder — anyone who needs your dog’s history.</h2>
        <p>
          Whether you’re seeing a specialist or leaving your dog with someone you trust, make their
          history part of the handoff. Send the link ahead of time or show the QR code when you
          arrive, so you’re not the only person who knows where to find it.
        </p>
      </div>

      <aside class="share-card" aria-label="Example BarkLens records share card">
        <p>Charlie - Records Share</p>
        <div class="share-card__main">
          <img src="/images/records/share-qr.png" alt="Example QR code for Charlie’s shared records" width="190" height="190" />
          <span>Scan for current meds, labs, and history.</span>
        </div>
        <div class="share-card__link">
          <span>barklens.com/8731</span>
          <b>Copy link</b>
        </div>
      </aside>
    </section>

    <section class="records-moments container">
      <h2>When it matters</h2>
      <div class="records-moments__grid">
        <article>
          <h3>An unexpected vet visit</h3>
          <p>
            You have enough to think about without searching for paperwork. Share the history
            you’ve saved while you explain what brought you in.
          </p>
        </article>
        <article>
          <h3>A specialist appointment</h3>
          <p>
            Give the new vet background before the conversation begins. Send your dog’s records
            ahead so you can focus on your questions, not rebuilding the timeline.
          </p>
        </article>
        <article>
          <h3>Someone else is taking your dog</h3>
          <p>
            Help a partner, family member, or sitter arrive prepared. Share the history beforehand
            so they have a reference when the vet asks.
          </p>
        </article>
        <article>
          <h3>A new clinic or a move</h3>
          <p>
            Changing vets shouldn’t mean rebuilding your own files. Bring the records you’ve
            collected in BarkLens and share them with the new clinic.
          </p>
        </article>
      </div>
      <div class="records-moments__cta">
        <ButtonLink href={routes.waitlist}>Join</ButtonLink>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .records-page {
    color: var(--color-forest-900);
    background: #fff;
  }

  .records-page > .container {
    width: min(calc(100% - 2 * var(--space-10)), 68.75rem);
  }

  .records-lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    align-items: center;
    gap: 3rem 5rem;
    padding-block: 5.5rem 3rem;
  }

  .records-page__hero {
    min-width: 0;
  }

  .records-title__mobile {
    display: none;
  }

  .records-page__hero h1 {
    max-width: 16ch;
    margin-top: 1.5rem;
    font-size: clamp(3.25rem, 4.5vw, 4.25rem);
    line-height: 1.03;
    text-wrap: balance;
  }

  .records-page__hero > p:last-child {
    max-width: 62ch;
    margin-top: 1.75rem;
    color: #273a33;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .records-share__copy {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .records-share__copy > .eyebrow,
  .records-share__copy > h2 {
    display: none;
  }

  .records-share__copy > p:not(.eyebrow) {
    max-width: none;
    margin-top: 0;
    color: #273a33;
    line-height: 1.65;
  }

  .share-card {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    padding: 2.25rem 2.25rem 1.75rem;
    border: 1px solid #d8ddd9;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1.25rem 3rem rgb(15 31 26 / 10%);
  }

  .share-card::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: .5rem;
    border-radius: 1rem 0 0 1rem;
    background: var(--color-mint-500);
    content: '';
  }

  .share-card > p {
    color: var(--color-green-600);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .19em;
    text-transform: uppercase;
  }

  .share-card__main {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .share-card__main img {
    width: 9rem;
    height: 9rem;
    image-rendering: pixelated;
  }

  .share-card__main span {
    max-width: 13ch;
    color: #273a33;
    line-height: 1.5;
  }

  .share-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: .4rem .4rem .4rem 1rem;
    border: 1px solid #d8ddd9;
    border-radius: var(--radius-pill);
    color: #52615b;
    font-size: .75rem;
  }

  .share-card__link b {
    padding: .5rem .875rem;
    border-radius: var(--radius-pill);
    color: #fff;
    background: var(--color-forest-900);
    font-size: .6875rem;
    white-space: nowrap;
  }

  .records-moments {
    padding-block: 2.5rem 6rem;
    border-top: 1px solid var(--color-border);
  }

  .records-moments > h2 {
    font-size: 2rem;
  }

  .records-moments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .records-moments article {
    min-height: 10rem;
    padding: 2rem 2.25rem;
    border-radius: .875rem;
    background: var(--color-cream-200);
  }

  .records-moments h3 {
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .records-moments article p {
    margin-top: .875rem;
    color: #273a33;
    font-size: .9375rem;
    line-height: 1.6;
  }

  .records-moments__cta {
    margin-top: 4rem;
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .records-lead {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .share-card {
      grid-column: 1;
      grid-row: auto;
      width: min(100%, 32rem);
    }
  }

  @media (max-width: 47.99rem) {
    .records-page > .container {
      width: min(calc(100% - 2 * var(--space-5)), 68.75rem);
    }

    .records-lead {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-block: 0 4rem;
    }

    .records-page__hero {
      padding-block: 4rem 3.5rem;
    }

    .records-title__desktop {
      display: none;
    }

    .records-title__mobile {
      display: block;
    }

    .records-page__hero h1 {
      margin-top: 1.125rem;
      font-size: clamp(2.8rem, 13vw, 3.65rem);
      line-height: 1.02;
    }

    .records-page__hero > p:last-child {
      margin-top: 1.5rem;
      font-size: 1rem;
    }

    .records-share__copy {
      display: block;
      padding-block: 1rem 3rem;
    }

    .records-share__copy > .eyebrow,
    .records-share__copy > h2 {
      display: block;
    }

    .records-share__copy h2 {
      max-width: 15ch;
      margin-top: 1.125rem;
      font-size: 2.45rem;
    }

    .records-share__copy > p:not(.eyebrow) {
      font-size: .975rem;
    }

    .share-card {
      padding: 1.75rem 1.25rem 1.25rem 1.75rem;
    }

    .share-card__main {
      grid-template-columns: 7.5rem 1fr;
      gap: 1rem;
    }

    .share-card__main img {
      width: 7.5rem;
      height: 7.5rem;
    }

    .share-card__link {
      min-width: 0;
      padding-left: .75rem;
    }

    .share-card__link span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .records-moments {
      padding-block: 2.5rem 4rem;
    }

    .records-moments__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .records-moments article {
      min-height: 0;
      padding: 1.5rem;
    }

    .records-moments__cta {
      margin-top: 2.5rem;
    }
  }
</style>
